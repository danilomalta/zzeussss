{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — Reajuste percentual do catálogo online",
    "version": "30.0",
    "description": "Seleção explícita até 100 produtos versionados. Preços calculados em centavos, half-up sobre preço final. Prévia sem gravação, lote atômico auditado, replay e histórico. Owner/admin/manager, sem segunda aprovação, custo/margem ou seleção automática por categoria."
  },
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SelectionItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "expected_version"
        ],
        "properties": {
          "product_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740990
          }
        }
      },
      "PreviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "reason",
          "rate_basis_points",
          "items"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rate_basis_points": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000,
            "not": {
              "enum": [
                0
              ]
            },
            "description": "100 = +1%, -125 = -1,25%; zero proibido. Limite -100% a +100%."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/SelectionItem"
            }
          }
        }
      },
      "ApplyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "reason",
          "rate_basis_points",
          "items",
          "preview_hash"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rate_basis_points": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000,
            "not": {
              "enum": [
                0
              ]
            },
            "description": "100 = +1%, -125 = -1,25%; zero proibido. Limite -100% a +100%."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/SelectionItem"
            }
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "reason",
          "rate_basis_points",
          "rounding",
          "preview_hash",
          "items"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rate_basis_points": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000,
            "not": {
              "enum": [
                0
              ]
            },
            "description": "100 = +1%, -125 = -1,25%; zero proibido. Limite -100% a +100%."
          },
          "rounding": {
            "type": "string",
            "enum": [
              "half_up"
            ]
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "./online-catalog-batches.openapi.json#/components/schemas/PreviewItem"
            }
          }
        }
      },
      "AdjustmentReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "actor_id",
          "reason",
          "rate_basis_points",
          "rounding",
          "preview_hash",
          "batch",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rate_basis_points": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000,
            "not": {
              "enum": [
                0
              ]
            },
            "description": "100 = +1%, -125 = -1,25%; zero proibido. Limite -100% a +100%."
          },
          "rounding": {
            "type": "string",
            "enum": [
              "half_up"
            ]
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "batch": {
            "$ref": "./online-catalog-batches.openapi.json#/components/schemas/BatchReceipt"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/AdjustmentReceipt"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/catalog/adjustments/preview": {
      "post": {
        "operationId": "online_adjustment_post__api_v1_catalog_adjustments_preview",
        "description": "Prévia do percentual aplicada à seleção de IDs/versões. Sem escrita comercial. Um no-op, excesso do preço máximo, produto ausente ou conflito recusa a seleção completa.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prévia, recibo/replay ou histórico, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, no-op, preço fora do limite ou paginação inválida"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Produto ou recibo ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash ou identidade em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte recibo"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              },
              "example": {
                "operation_id": "11111111-1111-4111-8111-111111111111",
                "reason": "Reajuste de tabela revisado",
                "rate_basis_points": 500,
                "items": [
                  {
                    "product_id": 1,
                    "expected_version": 2
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/adjustments/apply": {
      "post": {
        "operationId": "online_adjustment_post__api_v1_catalog_adjustments_apply",
        "description": "Aplica preços, auditoria, lote e metadados na mesma transação. Motivo, seleção normalizada, percentual, usuário e snapshots vinculados ao hash. Identidade já ocupada em outro lote gera conflito.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prévia, recibo/replay ou histórico, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdjustmentReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, no-op, preço fora do limite ou paginação inválida"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Produto ou recibo ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash ou identidade em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte recibo"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              },
              "example": {
                "operation_id": "11111111-1111-4111-8111-111111111111",
                "reason": "Reajuste de tabela revisado",
                "rate_basis_points": 500,
                "items": [
                  {
                    "product_id": 1,
                    "expected_version": 2
                  }
                ],
                "preview_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/adjustments/{operation_id}": {
      "get": {
        "operationId": "online_adjustment_get__api_v1_catalog_adjustments_operation_id",
        "description": "Consulta de recibo estável pela empresa e ator aplicador. Replay retorna resultado original antes de ler preços atuais; após resposta perdida preservar UUID e pedido e consultar esta rota.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID canônico, minúsculo e não nulo."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia, recibo/replay ou histórico, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdjustmentReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, no-op, preço fora do limite ou paginação inválida"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Produto ou recibo ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash ou identidade em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte recibo"
          }
        }
      }
    },
    "/api/v1/catalog/adjustments": {
      "get": {
        "operationId": "online_adjustment_get__api_v1_catalog_adjustments",
        "description": "Histórico administrativo da empresa, incluindo outros atores autorizados. Mais recente primeiro, com snapshots, motivo e percentual originais. Limite padrão 10; máximo 10, sem limite ilimitado.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia, recibo/replay ou histórico, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, no-op, preço fora do limite ou paginação inválida"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Produto ou recibo ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash ou identidade em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte recibo"
          }
        }
      }
    }
  }
}
