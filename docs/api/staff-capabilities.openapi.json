  "paths": {
    "/local/v1/capabilities": {
      "get": {
        "operationId": "localCapabilities",
        "summary": "Consulta permissões e contrato",
        "description": "Sessão ativa, loja e aparelho aprovados. Retorna subconjunto de dez permissões operacionais; não é inventário completo de administração. Permissões independem da lista de módulos: UI deve combinar permissão, módulo e vigência; backend revalida em cada ação. Nenhuma permissão informada substitui autorização no servidor. Consulta pode avançar last_observed_unix do contrato. Ausência de verificador: unavailable; sem contrato: not_installed; assinatura inválida: invalid; relógio retrocedido: clock_blocked.",
        "security": [
          {
            "Session": []
          }
        ],
        "parameters": [
          {
            "$ref": "./http-errors.openapi.json#/components/parameters/ErrorFormat"
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
