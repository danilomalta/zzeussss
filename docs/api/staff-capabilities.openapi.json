  "components": {
    "securitySchemes": {
      "Session": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sessão local opaca; contexto do servidor."
      }
    },
    "schemas": {
      "StaffInput": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "identity_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "manager",
              "employee",
              "cashier",
              "stock",
              "production",
              "accountant",
              "supplier"
            ]
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "description": "12–72 bytes, sem espaços nas bordas; nunca incluir em logs ou respostas."
          }
        },
        "required": [
          "operation_id",
          "identity_id",
          "name",
          "role",
          "password"
        ],
        "additionalProperties": false
      },
      "StaffResult": {
        "type": "object",
        "properties": {
          "identity_id": {
            "type": "string"
          },
          "repeated": {
            "type": "boolean"
          }
        },
        "required": [
          "identity_id",
          "repeated"
        ],
        "additionalProperties": false
      },
      "StaffMember": {
        "type": "object",
        "properties": {
          "identity_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "employee",
              "cashier",
              "stock",
              "production",
              "accountant",
              "supplier"
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "identity_id",
          "name",
          "role",
          "status"
        ],
        "additionalProperties": false
      },
      "StaffPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaffMember"
            },
            "maxItems": 100
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "License": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "not_yet_valid",
              "unavailable",
              "not_installed",
              "clock_blocked",
              "invalid"
            ]
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "core",
                "inventory",
                "pos",
                "orders",
                "logistics",
                "finance",
                "fiscal",
                "accounting",
                "staff",
                "production"
              ]
            }
          },
          "expires_unix": {
            "type": "integer",
            "format": "int64"
          },
          "remaining_days": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "state",
          "modules",
          "remaining_days"
        ],
        "additionalProperties": false,
        "description": "Metadados assinados, não fatura. Expirado/futuro pode conservar módulos contratados; somente active indica vigência atual. remaining_days é arredondado para cima em active; zero nos demais estados. expires_unix pode ser omitido."
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "store_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "identity_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "employee",
              "cashier",
              "stock",
              "production",
              "accountant",
              "supplier"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "view_catalog",
                "sell",
                "manage_stock",
                "manage_staff",
                "view_accounting",
                "manage_production",
                "view_orders",
                "manage_replenishment",
                "manage_cash",
                "cancel_sale"
              ]
            }
          },
          "license": {
            "$ref": "#/components/schemas/License"
          }
        },
        "required": [
          "tenant_id",
          "store_id",
          "device_id",
          "identity_id",
          "role",
          "permissions",
          "license"
        ],
        "additionalProperties": false
      },
      "ContractEnvelope": {
        "type": "object",
        "properties": {
          "key_id": {
            "type": "string"
          },
          "payload": {
            "type": "string",
            "format": "byte",
            "description": "Bytes exatos do JSON de claims, codificados em base64; não objeto JSON aninhado."
          },
          "signature": {
            "type": "string",
            "format": "byte",
            "description": "Assinatura Ed25519 em base64; chave privada nunca enviada."
          }
        },
        "required": [
          "key_id",
          "payload",
          "signature"
        ],
        "additionalProperties": false
      },
      "ContractResult": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "repeated": {
            "type": "boolean"
          }
        },
        "required": [
          "revision",
          "repeated"
        ],
        "additionalProperties": false
      }
    }
  }
}
