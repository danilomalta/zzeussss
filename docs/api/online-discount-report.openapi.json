  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product_id",
          "current_product_version",
          "nome",
          "sku",
          "ativo",
          "current_price_cents",
          "discount_bps",
          "status",
          "suggestion_reason",
          "reviewed_by",
          "review_reason",
          "operation_id",
          "has_receipt",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "current_product_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nome": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "ativo": {
            "type": "boolean"
          },
          "current_price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "discount_bps": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 10000
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "suggestion_reason": {
            "type": "string"
          },
          "reviewed_by": {
            "type": "string"
          },
          "review_reason": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "description": "UUID do recibo, ou vazio para sugestão sem recibo."
          },
          "has_receipt": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "active",
          "status",
          "limit",
          "offset",
          "total",
          "items",
          "has_more",
          "generated_at",
          "source_hash"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 120
          },
          "active": {
            "type": "string",
            "enum": [
              "all",
              "active",
              "inactive"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "all",
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "next_offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 1000000100
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "active",
          "total",
          "pending",
          "approved",
          "rejected",
          "final_without_receipt",
          "generated_at"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 120
          },
          "active": {
            "type": "string",
            "enum": [
              "all",
              "active",
              "inactive"
            ]
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pending": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "approved": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rejected": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "final_without_receipt": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "erro"
        ],
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      }
    }
  }
}
