{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan — Relatório de sugestões de desconto",
    "version": "1.0.0",
    "description": "Cinco funções somente de leitura. Preço/versão atuais; aprovação não significa desconto aplicado na venda. Requer schema16. Snapshot consistente por requisição, sem snapshot global entre páginas."
  },
  "paths": {
    "/api/v1/discounts/report/summary": {
      "get": {
        "operationId": "discountReportSummary",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Owner/admin/manager. Filtro q literal por nome ou SKU, sem busca fiscal/fuzzy. Contagens por estado.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "active",
                "inactive"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado real da empresa autenticada; no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Query inválida, extra, duplicada ou corpo GET não vazio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente, expirada ou revogada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Papel não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco/schema indisponível ou dados inconsistentes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
