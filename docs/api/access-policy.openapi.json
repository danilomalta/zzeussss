{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan Local — políticas e auditoria de acesso",
    "version": "1.0.0",
    "description": "API local da entrega 03. Sessão e aparelho determinam empresa/loja. Departamentos agrupam pessoas; não delimitam linhas de vendas/estoque. Administradores delegados não ganham permissão para mudar donos, credenciais ou contratos. Auditoria cobre políticas, segurança de conta, administração de acesso e cadastro de funcionários; demais fontes permanecem em seus módulos."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8181/local/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/access/policy": {
      "get": {
        "operationId": "readAccessPolicy",
        "summary": "Consultar configuração da loja/departamento",
        "parameters": [
          {
            "in": "query",
            "name": "department_id",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Obrigatório para delegado. Dono pode omitir para consultar esta loja inteira. Nunca permite escolher outra loja."
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado confirmado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Policy"
                }
              }
            }
          },
          "400": {
            "description": "JSON/query inválidos, campos extras/duplicados, cursor de outro escopo ou snapshot acima de 500 itens; filtre um departamento."
          },
          "401": {
            "description": "Sessão/aparelho revogados ou senha incorreta."
          },
          "403": {
            "description": "Escopo, alvo, delegação ou teto de permissão não autorizados."
          },
          "409": {
            "description": "Revisão atual difere da esperada ou operation_id reutilizado com outro pedido."
          },
          "413": {
            "description": "Corpo acima de 4096 bytes."
          },
          "415": {
            "description": "Content-Type diferente de application/json."
          },
          "429": {
            "description": "Limite de 20 mutações por minuto por IP."
          },
          "500": {
            "description": "Falha interna; a transação não confirmou a alteração."
          }
        }
      },
      "post": {
        "operationId": "changeAccessPolicy",
        "summary": "Alterar departamento, associação, regra ou delegação com senha atual",
        "description": "kind=department: target_id/permission vazios, name preenchido, value active/inactive. kind=member: target_id preenchido, permission/name vazios, value assigned. kind=rule: permission válida, name vazio, value allow/deny/inherit, target_id vazio para grupo ou preenchido para pessoa associada ao departamento. kind=delegation: target_id preenchido, permission/name vazios, value active/revoked. Campos não usados precisam ser string vazia. Somente dono cria/edita departamentos/delegações e regras de grupo. Delegado associa pessoas sem outro departamento e altera regras pessoais de employee/cashier/stock/production, exceto manage_staff, somente para ações que ele possui. Não pode alterar a si mesmo. Não há envio/sincronização dessas políticas nesta entrega.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado confirmado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyResult"
                }
              }
            }
          },
          "400": {
            "description": "JSON/query inválidos, campos extras/duplicados, cursor de outro escopo ou snapshot acima de 500 itens; filtre um departamento."
          },
          "401": {
            "description": "Sessão/aparelho revogados ou senha incorreta."
          },
          "403": {
            "description": "Escopo, alvo, delegação ou teto de permissão não autorizados."
          },
          "409": {
            "description": "Revisão atual difere da esperada ou operation_id reutilizado com outro pedido."
          },
          "413": {
            "description": "Corpo acima de 4096 bytes."
          },
          "415": {
            "description": "Content-Type diferente de application/json."
          },
          "429": {
            "description": "Limite de 20 mutações por minuto por IP."
          },
          "500": {
            "description": "Falha interna; a transação não confirmou a alteração."
          }
        }
      }
    },
    "/access/audit": {
      "get": {
        "operationId": "readAccessAudit",
        "summary": "Consultar auditoria administrativa paginada sem segredos",
        "parameters": [
          {
            "in": "query",
            "name": "department_id",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Obrigatório para delegado. Dono pode omitir para consultar esta loja inteira. Nunca permite escolher outra loja."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado confirmado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "400": {
            "description": "JSON/query inválidos, campos extras/duplicados, cursor de outro escopo ou snapshot acima de 500 itens; filtre um departamento."
          },
          "401": {
            "description": "Sessão/aparelho revogados ou senha incorreta."
          },
          "403": {
            "description": "Escopo, alvo, delegação ou teto de permissão não autorizados."
          },
          "409": {
            "description": "Revisão atual difere da esperada ou operation_id reutilizado com outro pedido."
          },
          "413": {
            "description": "Corpo acima de 4096 bytes."
          },
          "415": {
            "description": "Content-Type diferente de application/json."
          },
          "429": {
            "description": "Limite de 20 mutações por minuto por IP."
          },
          "500": {
            "description": "Falha interna; a transação não confirmou a alteração."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PolicyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "current_password",
          "kind",
          "department_id",
          "target_id",
          "permission",
          "value",
          "name",
          "expected_revision",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "current_password": {
            "type": "string",
            "format": "password",
            "description": "Senha atual, 12–72 bytes. Nunca devolvida ou gravada em auditoria."
          },
          "kind": {
            "type": "string",
            "enum": [
              "department",
              "member",
              "rule",
              "delegation"
            ]
          },
          "department_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_id": {
            "type": "string",
            "maxLength": 128,
            "description": "Vazio para departamento/regra do grupo; identidade existente da loja para membro/regra pessoal/delegação. Não pode ser o próprio ator ou um dono."
          },
          "permission": {
            "type": "string",
            "enum": [
              "",
              "view_catalog",
              "sell",
              "manage_stock",
              "review_discount",
              "manage_staff",
              "view_accounting",
              "manage_production",
              "view_orders",
              "manage_replenishment",
              "manage_cash",
              "cancel_sale"
            ]
          },
          "value": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "assigned",
              "allow",
              "deny",
              "inherit",
              "revoked"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Revisão atual esperada, 0 para criação."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      },
      "PolicyResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "revision",
          "repeated"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "repeated": {
            "type": "boolean"
          }
        }
      },
      "Department": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Member": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity_id",
          "department_id",
          "revision"
        ],
        "properties": {
          "identity_id": {
            "type": "string"
          },
          "department_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Rule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_kind",
          "target_id",
          "permission",
          "effect",
          "revision"
        ],
        "properties": {
          "target_kind": {
            "type": "string",
            "enum": [
              "member",
              "department"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "permission": {
            "type": "string",
            "enum": [
              "view_catalog",
              "sell",
              "manage_stock",
              "review_discount",
              "manage_staff",
              "view_accounting",
              "manage_production",
              "view_orders",
              "manage_replenishment",
              "manage_cash",
              "cancel_sale"
            ]
          },
          "effect": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "inherit"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Delegation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity_id",
          "department_id",
          "status",
          "revision"
        ],
        "properties": {
          "identity_id": {
            "type": "string"
          },
          "department_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant_id",
          "store_id",
          "departments",
          "members",
          "rules",
          "delegations"
        ],
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "store_id": {
            "type": "string"
          },
          "departments": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Department"
            }
          },
          "members": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "rules": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Rule"
            }
          },
          "delegations": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Delegation"
            }
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "kind",
          "actor_id",
          "target_id",
          "department_id",
          "permission",
          "before",
          "after",
          "reason",
          "created_unix",
          "revision"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "department_id": {
            "type": "string"
          },
          "permission": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "created_unix": {
            "type": "integer",
            "format": "int64"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          },
          "next_cursor": {
            "type": "string",
            "description": "Vazio na última página; cursor opaco vinculado à empresa, loja e filtro de departamento."
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
