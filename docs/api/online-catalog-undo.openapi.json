{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — Reversão compensatória de lotes online",
    "version": "27.0",
    "description": "Preserva original, registra motivo e novas versões. Não aceita itens/valores fornecidos pelo cliente, não sobrescreve mudanças posteriores, não permite cadeia de reversões. Sem UI ou envio efetivo de outbox."
  },
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PreviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "source_operation_id",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "source_operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "ApplyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "source_operation_id",
          "reason",
          "preview_hash"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "source_operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "source_operation_id",
          "reason",
          "preview_hash",
          "items"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "source_operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "./online-catalog-batches.openapi.json#/components/schemas/PreviewItem"
            }
          }
        }
      },
      "UndoReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "source_operation_id",
          "reason",
          "actor_id",
          "preview_hash",
          "batch",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "source_operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e diferente do UUID nulo."
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "batch": {
            "$ref": "./online-catalog-batches.openapi.json#/components/schemas/BatchReceipt"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/catalog/undos/preview": {
      "post": {
        "operationId": "online_undo_post__api_v1_catalog_undos_preview",
        "description": "Prévia da reversão: valores anteriores e novas versões. Nenhuma gravação comercial. Owner/admin/manager podem reverter lote da mesma empresa, incluindo lote aplicado por outro operador.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo persistido/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão ausente ou expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Original ou reversão ausente neste contexto"
          },
          "409": {
            "description": "Versão/hash/identidade em conflito, original já revertido ou cadeia proibida"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte o resultado"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/undos/apply": {
      "post": {
        "operationId": "online_undo_post__api_v1_catalog_undos_apply",
        "description": "Nova operação compensatória atômica, com motivo e vínculo ao original. Só aplica se todos os produtos ainda correspondem exatamente ao resultado original. Um original pode ser revertido uma única vez.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo persistido/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UndoReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão ausente ou expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Original ou reversão ausente neste contexto"
          },
          "409": {
            "description": "Versão/hash/identidade em conflito, original já revertido ou cadeia proibida"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte o resultado"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/undos/{operation_id}": {
      "get": {
        "operationId": "online_undo_get__api_v1_catalog_undos_operation_id",
        "description": "Consulta do recibo original da reversão pela empresa e operador que a aplicou; outro operador recebe 404. Resultado estável mesmo após futuras edições.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID canônico, minúsculo e diferente do UUID nulo."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo persistido/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UndoReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão ausente ou expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Original ou reversão ausente neste contexto"
          },
          "409": {
            "description": "Versão/hash/identidade em conflito, original já revertido ou cadeia proibida"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte o resultado"
          }
        }
      }
    },
    "/api/v1/catalog/batches/{operation_id}/undo": {
      "get": {
        "operationId": "online_undo_get__api_v1_catalog_batches_operation_id_undo",
        "description": "Consulta administrativa da reversão de um lote original da empresa, por owner/admin/manager. Pode mostrar outro ator autorizado. 404 significa que não há reversão gravada nesse contexto; indisponibilidade não comprova ausência.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID canônico, minúsculo e diferente do UUID nulo."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo persistido/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UndoReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão ausente ou expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "Original ou reversão ausente neste contexto"
          },
          "409": {
            "description": "Versão/hash/identidade em conflito, original já revertido ou cadeia proibida"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou commit incerto; consulte o resultado"
          }
        }
      }
    }
  }
}
