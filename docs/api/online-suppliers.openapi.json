  "components": {
    "schemas": {
      "Supplier": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "active",
          "reason",
          "version",
          "creator_id",
          "last_actor_id",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Vazio ou endereço isolado sem nome/header; não comprova titularidade."
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "description": "Vazio ou 6..20 dígitos, com + espaços parênteses/hífens; sem chamada ou SMS."
          },
          "active": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "creator_id": {
            "type": "string",
            "format": "uuid"
          },
          "last_actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "name",
          "email",
          "phone",
          "active",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Vazio ou endereço isolado sem nome/header; não comprova titularidade."
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "description": "Vazio ou 6..20 dígitos, com + espaços parênteses/hífens; sem chamada ou SMS."
          },
          "active": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Update": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_version",
          "name",
          "email",
          "phone",
          "active",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740990,
            "format": "int64"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Vazio ou endereço isolado sem nome/header; não comprova titularidade."
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "description": "Vazio ou 6..20 dígitos, com + espaços parênteses/hífens; sem chamada ou SMS."
          },
          "active": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "supplier_id",
          "actor_id",
          "kind",
          "before",
          "after"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "supplier_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "update"
            ]
          },
          "before": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Supplier"
              }
            ]
          },
          "after": {
            "$ref": "#/components/schemas/Supplier"
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "active",
          "limit",
          "offset",
          "items",
          "total",
          "has_more"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "active": {
            "type": "string",
            "enum": [
              "all",
              "true",
              "false"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000,
            "format": "int64"
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Supplier"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000100,
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
