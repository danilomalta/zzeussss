              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, JSON estrito, query/corpo inesperado"
          },
          "401": {
            "description": "Sessão inválida ou revogada"
          },
          "403": {
            "description": "Papel sem autorização"
          },
          "404": {
            "description": "Não encontrado na empresa ou recibo de outro ator"
