        "operationId": "SupplierCreate47",
        "summary": "Cadastra contato com recibo idempotente",
        "description": "Somente owner/admin/manager. Empresa derivada da sessão e revalidada dentro da transação. Campos extras, repetidos/null/trailing JSON rejeitados; GET sem corpo. Queries desconhecidas/repetidas inválidas.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Recibo histórico imutável no replay; consulta/edição retorna registro atual.",
