  "components": {
    "securitySchemes": {
      "LocalSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OpenInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "inventory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "product_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "unit",
                    "kg",
                    "g",
                    "liter",
                    "ml",
                    "meter"
                  ]
                }
              },
              "required": [
                "product_id",
                "unit"
              ]
            }
          }
        },
        "required": [
          "operation_id",
          "inventory_id",
          "location_id",
          "title",
          "items"
        ]
      },
      "CountInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "product_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "counted_milli": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "product_id",
                "counted_milli"
              ]
            }
          }
        },
        "required": [
          "operation_id",
          "expected_revision",
          "items"
        ]
      },
      "StateInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "action": {
            "type": "string",
            "enum": [
              "submit",
              "reopen",
              "approve",
              "reject",
              "cancel"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "operation_id",
          "expected_revision",
          "action",
          "reason"
        ]
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "inventory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "action": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "submitted",
              "approved",
              "rejected",
              "cancelled"
            ]
          },
          "changed_lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "repeated": {
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "inventory_id",
          "action",
          "revision",
          "status",
          "changed_lines",
          "occurred_at",
          "repeated"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inventory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "created_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "inventory_id",
          "location_id",
          "title",
          "status",
          "revision",
          "created_by",
          "created_at",
          "updated_at"
        ]
      },
      "Line": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "unit": {
            "type": "string"
          },
          "counted_milli": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "previous_milli": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "difference_milli": {
            "type": "integer",
