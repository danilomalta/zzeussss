{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem B02B13 — fontes e saldos de contas a pagar",
    "version": "1.0.0"
  },
  "paths": {
    "/local/v1/finance/payables/{id}/installment-balances": {
      "get": {
        "operationId": "payable_readiness_InstallmentBalances_balances",
        "summary": "Saldos por parcela no mesmo snapshot",
        "description": "ViewAccounting; contexto da sessão. GET sem corpo, queries exatas e sem repetição. Fontes são próprias do ator e apenas uma consulta; não reservam dinheiro nem certificam autorização/licença para escrever. Revalidar na transação de pagamento/devolução existente. Nenhuma mutação.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot completo, Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallmentBalances"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Recurso ausente no contexto"
          },
          "409": {
            "description": "Histórico ou fonte inconsistente"
          },
          "422": {
            "description": "Fonte excede limite de segurança"
          },
          "500": {
            "description": "Falha interna sem resultado parcial"
          }
        }
      }
    },
    "/local/v1/finance/payables/{id}/cash-sources": {
      "get": {
        "operationId": "payable_readiness_CashCandidates_pay",
        "summary": "Sangrias próprias elegíveis para uma parcela",
        "description": "ViewAccounting; contexto da sessão. GET sem corpo, queries exatas e sem repetição. Fontes são próprias do ator e apenas uma consulta; não reservam dinheiro nem certificam autorização/licença para escrever. Revalidar na transação de pagamento/devolução existente. Nenhuma mutação.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          {
            "name": "installment_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot completo, Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashCandidates"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Recurso ausente no contexto"
          },
          "409": {
            "description": "Histórico ou fonte inconsistente"
          },
          "422": {
            "description": "Fonte excede limite de segurança"
          },
          "500": {
            "description": "Falha interna sem resultado parcial"
          }
        }
      }
    },
    "/local/v1/finance/payable-cash/{id}/return-sources": {
      "get": {
        "operationId": "payable_readiness_CashCandidates_return",
        "summary": "Suprimentos próprios elegíveis para devolução integral",
        "description": "ViewAccounting; contexto da sessão. GET sem corpo, queries exatas e sem repetição. Fontes são próprias do ator e apenas uma consulta; não reservam dinheiro nem certificam autorização/licença para escrever. Revalidar na transação de pagamento/devolução existente. Nenhuma mutação.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot completo, Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashCandidates"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão inválida"
          },
          "403": {
            "description": "Sem permissão"
          },
          "404": {
            "description": "Recurso ausente no contexto"
          },
          "409": {
            "description": "Histórico ou fonte inconsistente"
          },
          "422": {
            "description": "Fonte excede limite de segurança"
          },
          "500": {
            "description": "Falha interna sem resultado parcial"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "InstallmentBalance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "installment",
          "paid_cents",
          "returned_cents",
          "applied_cents",
          "outstanding_cents"
        ],
        "properties": {
          "installment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "due_on",
              "amount_cents"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "due_on": {
                "type": "string",
                "format": "date"
              },
              "amount_cents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "paid_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "returned_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "applied_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outstanding_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "InstallmentBalances": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payable_id",
          "state",
          "currency",
          "generated_at",
          "complete",
          "summary",
          "items"
        ],
        "properties": {
          "payable_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "cancelled"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "BRL"
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paid_cents",
              "returned_cents",
              "applied_cents",
              "outstanding_cents",
              "basis"
            ],
            "properties": {
              "paid_cents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "returned_cents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "applied_cents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outstanding_cents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "basis": {
                "type": "string",
                "enum": [
                  "declared_cash_audited_sources"
                ]
              }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 120,
            "items": {
              "$ref": "#/components/schemas/InstallmentBalance"
            }
          }
        }
      },
      "CashCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "session_id",
          "movement_id",
          "actor_id",
          "kind",
          "amount_cents",
          "occurred_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "movement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "withdrawal",
              "supply"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CashCandidates": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "target_id",
          "installment_id",
          "currency",
          "generated_at",
          "complete",
          "reservation_created",
          "write_authorization_checked",
          "amount_rule",
          "amount_limit_cents",
          "blocked_reason",
          "items",
          "total_count",
          "limit",
          "offset",
          "has_more"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "pay",
              "return"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "installment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "currency": {
            "type": "string",
            "enum": [
              "BRL"
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "reservation_created": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "write_authorization_checked": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "amount_rule": {
            "type": "string",
            "enum": [
              "up_to_outstanding",
              "exact_payment_amount"
            ]
          },
          "amount_limit_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "blocked_reason": {
            "type": "string",
            "enum": [
              "",
              "document_not_approved",
              "installment_fully_applied",
              "payment_history_limit",
              "historical_amount_limit",
              "payment_already_returned"
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/CashCandidate"
            }
          },
          "total_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "has_more": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
