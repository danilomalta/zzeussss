  "paths": {
    "/purchase-receiving/operations/{kind}/{id}/receipt": {
      "get": {
        "summary": "Recibo original, autorizado para empresa/loja/aparelho/operador de origem",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "authorize",
                "receipt",
                "reject",
                "void"
              ]
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recibo original; não altera estoque ou pedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OriginalOperation"
                }
              }
            }
          },
          "400": {
            "description": "Tipo, identificador ou query inválidos"
          },
          "401": {
            "description": "Sessão inválida"
          },
          "403": {
            "description": "Permissão/aparelho recusados"
          },
          "404": {
            "description": "Operação ausente no escopo original"
          },
          "409": {
            "description": "Dados/auditoria/vínculos inconsistentes"
          },
          "500": {
            "description": "Falha interna"
          }
        }
      }
    }
  },
