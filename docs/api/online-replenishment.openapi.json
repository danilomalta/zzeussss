{
  "openapi": "3.0.3",
  "info": {
    "title": "Reposição online — cinco funções44",
    "version": "1.0.0",
    "description": "Planejamento sobre parâmetros registrados. Alvo=max(mínimo,ponto de reposição,ceil(demanda diária*(prazo+revisão))); sugestão=max(alvo-saldo,0). Requer revisão humana. Não cria ordem, reserva, mensagem a fornecedor ou movimento de estoque. CSV por página, sem snapshot global entre páginas."
  },
  "paths": {
    "/api/v1/catalog/replenishment/summary": {
      "get": {
        "operationId": "onlineReplenishment44_1",
        "summary": "Resumo da necessidade de reposição",
        "description": "Empresa derivada da sessão e revalidada na leitura. GET sem corpo; parâmetros extras/repetidos e números inválidos recusados. Inativos não recebem suggested_units. ",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Busca literal em nome/SKU, espaços aparados. % e _ não são curingas.",
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "all"
              ],
              "default": "true"
            }
          },
          {
            "name": "review_days",
            "in": "query",
            "required": false,
            "description": "Dias até nova revisão de estoque. Soma-se ao prazo declarado de reposição. Não é data prometida pelo fornecedor.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 365,
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Planejamento calculado, sem gravações. CSV representa apenas a página e contém cabeçalho mesmo quando vazia.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, extra, vazia, repetida ou fora do limite."
          },
          "401": {
            "description": "Sessão revogada/expirada ou autenticação inválida."
          },
          "403": {
            "description": "Permitido apenas owner/admin/manager/stock."
          },
          "404": {
            "description": "Produto excluído, inexistente ou de outra empresa."
          },
          "409": {
            "description": "expected_version desatualizada na simulação."
          },
          "429": {
            "description": "Limite HTTP: aguarde Retry-After."
          },
          "503": {
            "description": "Dados persistidos inválidos ou dependência indisponível; não fabricar valores."
          }
        }
      }
    },
