        "properties": {
          "operation_id": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "from_state": {
            "type": "string"
          },
          "to_state": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "dispatch",
              "receive",
              "reject",
              "cancel"
            ]
          }
        }
      },
      "Bag": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "session_id",
          "withdrawal_operation_id",
          "movement_id",
          "sender_id",
          "operator_id",
          "seal_id",
          "created_at",
          "updated_at",
          "state",
          "declared_cents",
          "counted_cents",
          "difference_cents",
          "receiver_id",
          "received_at",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "withdrawal_operation_id": {
            "type": "string"
          },
          "movement_id": {
            "type": "string"
          },
          "sender_id": {
            "type": "string"
          },
          "operator_id": {
            "type": "string"
          },
          "seal_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "prepared",
              "in_transit",
              "received",
              "rejected",
              "cancelled"
            ]
          },
          "declared_cents": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "counted_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "difference_cents": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "receiver_id": {
            "type": "string",
            "nullable": true
          },
          "received_at": {
            "type": "string",
            "nullable": true
          },
          "history": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/BagEvent"
            }
          }
        }
      },
      "BagResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "repeated",
          "bag"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "repeated": {
            "type": "boolean"
          },
          "bag": {
            "$ref": "#/components/schemas/Bag"
          }
        }
      },
      "BagPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset",
          "total_count",
          "has_more"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Bag"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "total_count": {
            "type": "integer",
            "minimum": 0,
