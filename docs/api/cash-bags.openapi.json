    "/local/v1/cash/bags/{id}/review": {
      "get": {
        "operationId": "getCashBagInvestigation",
        "security": [
          {
            "localSession": []
          }
        ],
        "description": "Scoped custody evidence only. GET ManageCash; POST active owner + POS contract. Recount appends compensating evidence; original counts, vault and cash never change. Resolve acknowledges remaining variance, not a financial loss or reimbursement. Revision conflicts 409. Operation replay returns original snapshot. No automatic retry.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Investigation or original operation receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustodyReview"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or query"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Permission or license denied"
          },
          "404": {
            "description": "Bag not in scope"
          },
          "409": {
            "description": "Revision or state conflict"
          },
          "413": {
            "description": "Body too large"
          },
          "500": {
            "description": "Transaction failed"
          }
        }
      },
