{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan — Conferência de descontos aprovados",
    "version": "1.0.0",
    "description": "Cinco funções de leitura, sem aplicar desconto ou emitir garantia de elegibilidade. Preço/versão atuais comparados com snapshot da aprovação; receipt ausente explícito. Snapshot por requisição, schema16."
  },
  "paths": {
    "/api/v1/discounts/checks/summary": {
      "get": {
        "operationId": "discountChecksummary",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Owner/admin/manager. Produtos/sugestões excluídos logicamente não entram; inativos entram. Apenas APPROVED. Consulta de conferência não autoriza venda. Filtros fixos não podem ser sobrescritos na query.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conferência real de aprovações desta empresa; no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Entrada/query/corpo inválido"
          },
          "401": {
            "description": "Sessão ausente/revogada"
          },
          "403": {
            "description": "Papel não autorizado"
          },
          "503": {
            "description": "Banco/schema ou snapshot inconsistente"
          }
        }
      }
    },
    "/api/v1/discounts/checks/price-changed": {
      "get": {
        "operationId": "discountCheckprice_changed",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Owner/admin/manager. Produtos/sugestões excluídos logicamente não entram; inativos entram. Apenas APPROVED. Consulta de conferência não autoriza venda. Filtros fixos não podem ser sobrescritos na query.",
        "parameters": [
          {
