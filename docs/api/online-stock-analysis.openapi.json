    "/api/v1/catalog/stock/export.csv": {
      "get": {
        "operationId": "onlineStockCSV42",
        "summary": "CSV de uma página da análise de estoque",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Busca literal em nome/SKU. % e _ não são curingas; q vazio permite todos.",
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "description": "Opcional. Valores vazios, repetidos e parâmetros extras são recusados.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "all"
              ],
              "default": "true"
            }
          },
          {
            "name": "issue",
            "in": "query",
            "required": false,
            "description": "Opcional. Valores vazios, repetidos e parâmetros extras são recusados.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "zero_stock",
                "below_minimum",
                "low_coverage",
                "no_positive_demand"
              ],
              "default": "all"
            }
          },
          {
            "name": "horizon_days",
            "in": "query",
            "required": false,
            "description": "Horizonte para comparação exata; igualdade não é baixa cobertura. Não é prazo de entrega prometido.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 365,
              "default": 7
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Opcional. Valores vazios, repetidos e parâmetros extras são recusados.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Opcional. Valores vazios, repetidos e parâmetros extras são recusados.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Query inválida/repetida/extra ou corpo em GET."
          },
          "401": {
            "description": "Sessão ausente, expirada ou revogada."
          },
          "403": {
            "description": "Papel sem permissão."
          },
          "429": {
            "description": "Limite de requisições."
          },
          "503": {
            "description": "Banco indisponível ou demanda/resultado inconsistente."
          },
          "200": {
            "description": "Snapshot consistente por requisição, limitado à empresa e filtros. Não é inventário do PDV local.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "maxLength": 262144
                }
              }
            },
            "headers": {
              "X-Titan-Report-Total": {
                "schema": {
                  "type": "string"
                },
                "description": "Total dos produtos sob o filtro"
              },
              "X-Titan-Report-Count": {
                "schema": {
                  "type": "string"
                },
                "description": "Linhas da página"
              },
              "X-Titan-Report-Has-More": {
                "schema": {
                  "type": "string"
                },
                "description": "Páginas seguintes existem"
              },
              "X-Titan-Report-Next-Offset": {
                "schema": {
                  "type": "string"
                },
                "description": "Presente quando has_more"
              },
              "X-Titan-Source-Hash": {
                "schema": {
                  "type": "string"
                },
                "description": "Identificador SHA256 da página, não uma assinatura"
              },
              "X-Titan-Report-Scope": {
                "schema": {
                  "type": "string"
                },
                "description": "online-stock-analysis"
              },
              "X-Titan-CSV-Text-Escape": {
                "schema": {
                  "type": "string"
                },
                "description": "apostrophe"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string"
                },
                "description": "nosniff"
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"online-stock-analysis.csv\""
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome",
          "descricao",
          "sku",
          "price_cents",
          "ativo",
          "version",
          "stock_units",
          "minimum_units",
          "reorder_point_units",
          "daily_demand",
          "forecast_at",
          "coverage_days",
          "coverage_state",
          "below_minimum",
          "low_coverage",
          "missing_to_minimum"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 999999999999
          },
          "ativo": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "stock_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minimum_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "reorder_point_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "daily_demand": {
            "type": "string",
            "pattern": "^[0-9]{1,8}\\.[0-9]{4}$",
            "description": "Demanda registrada com quatro casas decimais, sem float."
          },
          "forecast_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Data registrada da previsão; null quando não informada. Não há garantia de atualização."
          },
          "coverage_days": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9]+\\.[0-9]{4}$",
            "description": "Estoque/demanda positiva; truncado a quatro casas apenas para apresentação. Null sem demanda positiva."
          },
          "coverage_state": {
            "type": "string",
            "enum": [
              "no_positive_demand",
              "below_horizon",
              "at_or_above_horizon"
            ]
          },
          "below_minimum": {
            "type": "boolean"
          },
          "low_coverage": {
            "type": "boolean"
          },
          "missing_to_minimum": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "active",
          "issue",
          "horizon_days",
          "limit",
          "offset",
          "total",
          "items",
          "has_more",
          "generated_at",
          "source_hash"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          },
          "active": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "all"
            ],
            "default": "true"
          },
          "issue": {
            "type": "string",
            "enum": [
              "all",
              "zero_stock",
              "below_minimum",
              "low_coverage",
              "no_positive_demand"
            ],
            "default": "all"
          },
          "horizon_days": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 365,
            "default": 7
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000,
            "default": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "active",
          "horizon_days",
          "products",
          "zero_stock",
          "below_minimum",
          "low_coverage",
          "no_positive_demand",
          "generated_at"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          },
          "active": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "all"
            ],
            "default": "true"
          },
          "horizon_days": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 365,
            "default": 7
          },
          "products": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "zero_stock": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "below_minimum": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "low_coverage": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "no_positive_demand": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
