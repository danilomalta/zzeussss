{
  "openapi": "3.0.3",
  "info": {
    "title": "Análise do estoque online — entrega42",
    "version": "1.0.0",
    "description": "Consulta dos campos do catálogo PostgreSQL. Não consulta nem sincroniza movimentos SQLite/PDV; não faz reserva, pedido, previsão automática ou alteração de estoque. Owner/admin/manager/stock, com empresa e sessão revalidadas."
  },
  "paths": {
    "/api/v1/catalog/stock/summary": {
      "get": {
        "operationId": "onlineStockSummary42",
        "summary": "Resumo de estoque e indicadores",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Busca literal em nome/SKU. % e _ não são curingas; q vazio permite todos.",
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "description": "Opcional. Valores vazios, repetidos e parâmetros extras são recusados.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "all"
              ],
              "default": "true"
            }
          },
          {
            "name": "horizon_days",
            "in": "query",
            "required": false,
            "description": "Horizonte para comparação exata; igualdade não é baixa cobertura. Não é prazo de entrega prometido.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 365,
              "default": 7
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Query inválida/repetida/extra ou corpo em GET."
          },
          "401": {
            "description": "Sessão ausente, expirada ou revogada."
          },
          "403": {
            "description": "Papel sem permissão."
          },
          "429": {
            "description": "Limite de requisições."
          },
          "503": {
            "description": "Banco indisponível ou demanda/resultado inconsistente."
          },
          "200": {
            "description": "Snapshot consistente por requisição, limitado à empresa e filtros. Não é inventário do PDV local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          }
        }
      }
    },
