{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan local fiscal preparation",
    "version": "0.1.0",
    "description": "Preparação durável, não emissão fiscal. Oito operações. Sem endpoint de ativação, transmissão, autorização, cancelamento fiscal, numeração ou credencial. Não substitui contrato de emissão/homologação posterior. Rejeita campos desconhecidos, duplicados, nulos, query duplicada e corpos em GET."
  },
  "servers": [
    {
      "url": "/local/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/fiscal/capabilities": {
      "get": {
        "summary": "Capacidades reais; transmissão, NFS-e e SPED indisponíveis",
        "responses": {
          "200": {
            "description": "Consulta/repetição",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "description": "Entrada ambígua ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sessão inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sem permissão ou módulo fiscal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Registro não encontrado neste contexto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de operação/revisão ou integridade",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
