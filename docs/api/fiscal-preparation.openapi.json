  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ProfileInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "profile_id",
          "expected_revision",
          "cnpj",
          "legal_name",
          "state",
          "municipality_ibge",
          "state_registration",
          "crt",
          "model",
          "environment",
          "series"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
            "maxLength": 128
          },
          "profile_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
            "maxLength": 128
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "cnpj": {
            "type": "string",
            "pattern": "^[A-Z0-9]{12}[0-9]{2}$",
            "description": "DV módulo 11 validado; não prova cadastro/credenciamento."
          },
          "legal_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 255,
            "description": "UTF-8 sem controles; no máximo255bytes, não somente255caracteres."
          },
          "state": {
            "type": "string",
            "enum": [
              "AC",
              "AL",
              "AP",
              "AM",
              "BA",
              "CE",
              "DF",
              "ES",
              "GO",
              "MA",
              "MT",
              "MS",
              "MG",
              "PA",
              "PB",
              "PR",
              "PE",
              "PI",
              "RJ",
              "RN",
              "RS",
              "RO",
              "RR",
              "SC",
              "SP",
              "SE",
              "TO"
            ]
          },
          "municipality_ibge": {
            "type": "string",
            "pattern": "^[0-9]{7}$",
            "description": "Prefixo deve corresponder à UF; existência cadastral ainda não consultada."
          },
          "state_registration": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,20}$"
          },
          "crt": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4"
            ]
          },
          "model": {
            "type": "string",
            "enum": [
              "55",
              "65"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "homologation",
              "production"
            ],
            "description": "Ambos permanecem sem transmissão; este campo não habilita produção."
          },
          "series": {
            "type": "integer",
            "minimum": 0,
            "maximum": 889
          }
        }
      },
      "IntentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "sale_id",
          "profile_id",
          "profile_revision"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
            "maxLength": 128
          },
          "sale_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
            "maxLength": 128
          },
