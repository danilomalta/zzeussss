{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — revisão humana de sugestões de desconto",
    "version": "36.0.0",
    "description": "Cinco funções reais. Owner/admin/manager. Empresa/ator derivados da sessão, revalidada no banco. Operação UUID persistida antes do envio. Decisão + recibo + outbox são atômicos; recuperação própria após perda de resposta. Aprovação não modifica preço, venda, caixa, estoque ou documento fiscal. Schema PostgreSQL incremental 16 por manutenção explícita."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/discounts/suggestions/{id}": {
      "get": {
        "operationId": "ConsultarSugestaoHumana36",
        "description": "Consulta o estado real e o produto atual para conferência humana.",
        "summary": "Consulta o estado real e o produto atual para conferência humana",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta o estado real e o produto atual para conferência humana.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suggestion"
                }
              }
            }
          },
          "400": {
            "description": "Entrada, UUID, limite, corpo ou query inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação inválida ou sessão revogada no guarda HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Papel/sessão/empresa não autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Sugestão ou recibo não encontrados no contexto autorizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Versão/percentual desatualizados, produto inativo na aprovação, decisão já tomada ou UUID/payload/ator em conflito.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco/schema indisponível ou resultado incerto. Guarde o UUID e consulte o recibo; não repetir automaticamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
