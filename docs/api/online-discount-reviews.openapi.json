  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_product_version",
          "expected_discount_bps",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_product_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expected_discount_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Suggestion": {
        "type": "object",
        "required": [
          "id",
          "product_id",
          "discount_bps",
          "status",
          "reviewed_by",
          "product",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "discount_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "reviewed_by": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "criteria": {
            "type": "string"
          },
          "suggested_range": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "product": {
            "$ref": "./online-catalog-management.openapi.json#/components/schemas/Product"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "operation_id",
          "suggestion_id",
          "actor_id",
          "action",
          "reason",
          "before",
          "after",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "suggestion_id": {
            "type": "integer",
            "format": "int64"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "reason": {
            "type": "string"
          },
          "before": {
            "$ref": "#/components/schemas/Suggestion"
          },
          "after": {
            "$ref": "#/components/schemas/Suggestion"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "History": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Receipt"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      }
    }
  }
