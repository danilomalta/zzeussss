{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan — cinco consultas de propostas de reposição",
    "version": "46.0.0",
    "description": "Resumo de estados, listagem filtrada, histórico por proposta, conferência de snapshot e CSV paginado. Quantidades de produtos diferentes não são somadas. Histórico de decisões visível aos gestores da empresa, mesmo quando a recuperação por operação45 é restrita ao próprio ator. Conferência não aprova nem reserva; can_approve é informativo neste instante e a decisão45 revalida com locks. Produto excluído/não localizado é product_unavailable. Proposta aprovada/cancelada não pode ser aprovada novamente. CSV contém o estado atual da proposta e identificação histórica do produto no snapshot; uma página até100 linhas e256KiB. Entre páginas, mudanças concorrentes podem deslocar registros: não se promete exportação completa imutável."
  },
  "paths": {
    "/api/v1/catalog/replenishment/proposals/summary": {
      "get": {
        "operationId": "ProposalSummary46",
        "summary": "Resumo das propostas por estado",
        "description": "Apenas owner/admin/manager. Sem corpo. Campos extras, repetidos e parâmetros numéricos vazios recusados.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Busca literal aparada nos nomes/SKUs do snapshot e motivo atual; % e _ não são curingas."
          },
          {
            "name": "product_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "format": "int64"
            },
            "description": "Filtro por produto; não aceita0 nem zeros à esquerda. Sem parâmetro, todos os produtos."
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta sem mutação. Cada chamada usa snapshot transacional; páginas diferentes não compartilham uma sessão de exportação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Entrada/query inválida"
          },
          "401": {
            "description": "Sessão inválida/revogada"
          },
          "403": {
            "description": "Papel não autorizado"
          },
          "404": {
            "description": "Proposta fora da empresa ou inexistente"
          },
          "429": {
            "description": "Limite HTTP excedido"
          },
          "503": {
            "description": "Persistência ou dados inválidos, sem logs SQL brutos"
          }
        }
      }
    },
    "/api/v1/catalog/replenishment/proposals": {
      "get": {
        "operationId": "ProposalList46",
        "summary": "Lista paginada de propostas",
        "description": "Apenas owner/admin/manager. Sem corpo. Campos extras, repetidos e parâmetros numéricos vazios recusados.",
        "security": [
