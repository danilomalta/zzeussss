    "/catalog/quality/export.csv": {
      "get": {
        "operationId": "catalogQualityCSV",
        "summary": "CSV de uma página de pendências",
        "description": "CSV de uma página de pendências. Não é arquivo para reimportação. Nomes/SKUs com prefixo de fórmula recebem apóstrofo somente no relatório. Headers informam total, count, has-more e next-offset. Páginas independentes; alterações simultâneas podem deslocar a paginação. Não afirma exportação completa.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Busca literal por trecho de nome ou SKU; %, _ e barra invertida não são curingas. Não ignora acentos."
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "active"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          },
          {
            "name": "issue",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "no_active_gtin",
                "no_description",
                "zero_stock"
              ],
              "default": "any"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV de uma página de pendências. Não é arquivo para reimportação. Nomes/SKUs com prefixo de fórmula recebem apóstrofo somente no relatório. Headers informam total, count, has-more e next-offset. Páginas independentes; alterações simultâneas podem deslocar a paginação. Não afirma exportação completa.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "X-Titan-Report-Total": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Titan-Report-Count": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Titan-Report-Has-More": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Titan-Report-Next-Offset": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Titan-Source-Hash": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Titan-Report-Scope": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Titan-CSV-Text-Escape": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Filtro, paginação, parâmetro desconhecido/duplicado ou corpo GET inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação inválida ou sessão revogada no guarda HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Papel ou sessão não autorizados; revalidação do banco pode negar sessão alterada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco, schema GTIN ou dados indisponíveis; sem sucesso fabricado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "QualityItem": {
        "type": "object",
        "required": [
          "id",
          "version",
          "nome",
          "descricao",
          "sku",
          "price_cents",
          "ativo",
          "estoque",
          "issues"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ativo": {
            "type": "boolean"
          },
          "estoque": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "issues": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "no_active_gtin",
                "no_description",
                "zero_stock"
              ]
            }
          }
        }
      },
      "QualitySummary": {
        "type": "object",
        "required": [
          "q",
          "active",
          "products",
          "pending_products",
          "no_active_gtin",
          "no_description",
          "zero_stock",
          "generated_at"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "active": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "all"
            ]
          },
          "products": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pending_products": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "no_active_gtin": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "no_description": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "zero_stock": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QualityPage": {
        "type": "object",
        "required": [
          "q",
          "active",
          "issue",
          "limit",
          "offset",
          "total",
          "items",
          "has_more",
          "source_hash",
          "generated_at"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "active": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/QualityItem"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      }
    }
  }
}
