{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem catálogo online — pendências operacionais",
    "version": "35.0.0",
    "description": "Cinco funções de leitura real. Empresa derivada da sessão; owner/admin/manager/stock. Cada resposta usa snapshot repeatable-read e revalida sessão, papel e empresa no banco. Sem alteração de dados, novas migrações ou backend fiscal."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/catalog/quality/summary": {
      "get": {
        "operationId": "catalogQualitySummary",
        "summary": "Resumo de pendências: products é o total filtrado; pending_products conta cada produto uma vez",
        "description": "Resumo de pendências: products é o total filtrado; pending_products conta cada produto uma vez. Contagens por categoria se sobrepõem.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Busca literal por trecho de nome ou SKU; %, _ e barra invertida não são curingas. Não ignora acentos."
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "active"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumo de pendências: products é o total filtrado; pending_products conta cada produto uma vez. Contagens por categoria se sobrepõem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualitySummary"
                }
              }
            }
          },
          "400": {
            "description": "Filtro, paginação, parâmetro desconhecido/duplicado ou corpo GET inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação inválida ou sessão revogada no guarda HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Papel ou sessão não autorizados; revalidação do banco pode negar sessão alterada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco, schema GTIN ou dados indisponíveis; sem sucesso fabricado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/catalog/quality/no-active-gtin": {
      "get": {
        "operationId": "catalogQualityNoGTIN",
        "summary": "Produtos sem nenhum GTIN ativo na empresa",
        "description": "Produtos sem nenhum GTIN ativo na empresa. GTIN inativo não resolve pendência; nunca usa SKU como GTIN.",
