            "description": "Busca literal por trecho de nome ou SKU; %, _ e barra invertida não são curingas. Não ignora acentos."
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "active"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Produtos sem nenhum GTIN ativo na empresa. GTIN inativo não resolve pendência; nunca usa SKU como GTIN.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityPage"
                }
              }
            }
          },
          "400": {
            "description": "Filtro, paginação, parâmetro desconhecido/duplicado ou corpo GET inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Autenticação inválida ou sessão revogada no guarda HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Papel ou sessão não autorizados; revalidação do banco pode negar sessão alterada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco, schema GTIN ou dados indisponíveis; sem sucesso fabricado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
