          },
          "200": {
            "description": "Resultado real com cache no-store; no replay recibo original, não estado atual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Add"
              }
            }
          }
        }
      }
