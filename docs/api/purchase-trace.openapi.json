{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem P18 — Rastreabilidade de pedido de compra",
    "version": "P18",
    "description": "Pedido/item preservados, aprovacao humana e auditoria de criacao em uma transacao autorizada view_orders. Fornecedor e referencia local; estado real local_not_sent. Sem escrita/envio/recebimento/estoque."
  },
  "servers": [
    {
      "url": "/local/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/purchase-orders/{id}/trace": {
      "get": {
        "operationId": "getPurchaseOrderTrace",
        "summary": "Consulta pedido, aprovacao humana e auditoria de criacao",
        "description": "Empresa e loja derivadas da sessao. Query parameters nao sao aceitos. Leitura preservada apos vencimento do contrato. Confronta audit e aprovacao com o pedido, sem substituir item por catalogo atual. Datas sao registros dos aparelhos, sem garantia de relogio global.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "ID exato do pedido, apos decodificacao URL. Limite de 128 bytes; sem espacos nas bordas, NUL, CR ou LF."
          }
        ],
        "responses": {
          "200": {
            "description": "Rastreabilidade local consistente. Evidencias sao registros SQLite, nao prova criptografica de integridade historica.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trace"
                }
              }
            }
          },
          "400": {
            "description": "ID invalido ou qualquer query parameter."
          },
          "401": {
            "description": "Sessao, vinculo ou aparelho invalido/revogado."
          },
          "403": {
            "description": "Sem view_orders na empresa/loja da sessao."
          },
          "404": {
            "description": "Pedido nao encontrado no escopo autorizado."
          },
          "409": {
            "description": "Item, estado, aprovacao ou auditoria inconsistente. Sem resposta parcial."
          },
          "500": {
            "description": "Falha interna de leitura."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "product_id",
          "sku",
          "name",
          "unit",
          "quantity_milli"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "unit",
              "kg",
              "g",
              "liter",
              "ml",
              "meter"
            ]
          },
          "quantity_milli": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "operation_id",
          "supplier_id",
          "supplier_name",
          "suggestion_id",
          "created_at",
          "approved_by",
          "approved_at",
          "status",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "suggestion_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "local_not_sent"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        }
      },
      "Creation": {
        "type": "object",
        "required": [
          "operation_id",
          "device_id",
          "actor_id",
          "created_at",
          "kind"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "purchase.created"
            ]
          }
        }
      },
      "Approval": {
        "type": "object",
        "required": [
          "suggestion_id",
          "operation_id",
          "device_id",
          "reviewer_id",
          "reason",
          "decided_at",
          "decision"
        ],
        "properties": {
          "suggestion_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "reviewer_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "decided_at": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved"
            ]
          }
        }
      },
      "Trace": {
        "type": "object",
        "required": [
          "order",
          "creation",
          "approval"
        ],
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "creation": {
            "$ref": "#/components/schemas/Creation"
          },
          "approval": {
            "$ref": "#/components/schemas/Approval"
          }
        }
      }
    }
  }
}
