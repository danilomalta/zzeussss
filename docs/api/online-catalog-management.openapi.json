    "/api/v1/catalog/operations/{operation_id}": {
      "get": {
        "operationId": "catalog_get__api_v1_catalog_operations_operation_id",
        "description": "Recibo somente do operador autenticado; owner/admin/manager/stock. Permite consultar após perda de resposta e novo login. Campos desconhecidos/duplicados/nulos e seletores de empresa são recusados.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot atual ou recibo durável (mesmo recibo no replay).",
