{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — gestão de catálogo online",
    "version": "1.0.0",
    "description": "Extensão PostgreSQL explícita 000008. Empresa, operador e papel vêm da sessão. Preço em centavos; nenhum estoque é ajustado. Não altera SQLite nem entrega preços aos caixas."
  },
  "paths": {
    "/api/v1/produtos/{id}": {
      "get": {
        "operationId": "catalog_get__api_v1_produtos_id",
        "description": "Consulta individual, inclusive inativo. Todos os papéis operacionais do catálogo. Campos desconhecidos/duplicados/nulos e seletores de empresa são recusados.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,15}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot atual ou recibo durável (mesmo recibo no replay).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "400": {
            "description": "Entrada, ID ou paginação inválidos."
          },
          "401": {
            "description": "Sessão inválida ou revogada."
          },
          "403": {
            "description": "Papel ou vínculo sem autorização."
          },
          "404": {
            "description": "Produto/operação ausente neste contexto."
          },
          "409": {
            "description": "Versão obsoleta, SKU duplicado ou operação reutilizada com dados diferentes."
          },
          "429": {
            "description": "Limite HTTP da API."
          },
          "503": {
            "description": "Banco/extensão indisponível; resultado de escrita pode ser incerto. Consulte a operação."
          }
        }
      }
    },
