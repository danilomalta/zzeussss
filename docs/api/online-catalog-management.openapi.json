  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome",
          "descricao",
          "sku",
          "price_cents",
          "ativo",
          "version"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 999999999999
          },
          "ativo": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "product_id",
          "actor_id",
          "action",
          "before",
          "after",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "details",
              "price",
              "active"
            ]
          },
          "before": {
            "$ref": "#/components/schemas/Product"
          },
          "after": {
            "$ref": "#/components/schemas/Product"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "History": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Receipt"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      },
      "Details": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_version",
          "nome",
          "descricao",
          "sku"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID não nulo canônico, persistido pelo cliente antes do envio."
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "Price": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_version",
          "price_cents"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID não nulo canônico, persistido pelo cliente antes do envio."
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 999999999999
          }
        }
      },
      "Active": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_version",
          "ativo"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID não nulo canônico, persistido pelo cliente antes do envio."
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "ativo": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
