{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan local — purchase receiving overview",
    "version": "2026-10-22.1"
  },
  "paths": {
    "/local/v1/purchase-orders/{id}/receiving-overview": {
      "get": {
        "operationId": "purchase_receiving_overview",
        "description": "Read-only single transaction in current tenant/store, current ViewOrders+ManageStock and approved device. Combines existing one-product order receiving trace, validates receipts/stock evidence/voids and full rejection evidence before appointment pagination. Max1000 combined receipt + rejection + void + appointment source rows per order, including cancelled/history, otherwise422 no partial totals. Quantity in thousandths, never mixed units; full rejection/void aggregate exact decimal strings. Voids remove effective accepted quantity, never represent refund, collection or physical return. Full rejections do not reduce outstanding quantity. Local authorization not external supplier confirmation. Supplier confirmation always not_proven_by_local_records; payment evaluation always not_evaluated. Appointment link is by order_id only, not a delivery-reference/vehicle match. Completed dock plus remainder is a REVIEW flag, not proof of fault. Cancellation does not mutate agenda or trigger reorder. Summary covers all evidence independent of current appointment page. No contract renewal for authorized historical reading, no writes, side effects or financial evaluation.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          }
        ],
        "security": [
          {
            "BearerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Receiving overview; totals and review flags independent of appointment pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceivingOverview"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Unknown/duplicate/invalid query, GET body or ID"
          },
          "401": {
            "description": "Session absent/revoked/context changed"
          },
          "403": {
            "description": "Current permissions/device denied"
          },
          "404": {
            "description": "Order not found in current scope"
          },
          "409": {
            "description": "Contradictory receipt, rejection, stock, void or agenda evidence"
          },
          "422": {
            "description": "More than1000 source evidence records for this order; no partial totals"
          },
          "500": {
            "description": "Read failure"
          }
        }
      }
    },
    "/local/v1/purchase-orders/{id}/receiving-overview.csv": {
      "get": {
        "operationId": "purchase_receiving_overview_csv",
        "description": "Read-only single transaction in current tenant/store, current ViewOrders+ManageStock and approved device. Combines existing one-product order receiving trace, validates receipts/stock evidence/voids and full rejection evidence before appointment pagination. Max1000 combined receipt + rejection + void + appointment source rows per order, including cancelled/history, otherwise422 no partial totals. Quantity in thousandths, never mixed units; full rejection/void aggregate exact decimal strings. Voids remove effective accepted quantity, never represent refund, collection or physical return. Full rejections do not reduce outstanding quantity. Local authorization not external supplier confirmation. Supplier confirmation always not_proven_by_local_records; payment evaluation always not_evaluated. Appointment link is by order_id only, not a delivery-reference/vehicle match. Completed dock plus remainder is a REVIEW flag, not proof of fault. Cancellation does not mutate agenda or trigger reorder. Summary covers all evidence independent of current appointment page. No contract renewal for authorized historical reading, no writes, side effects or financial evaluation.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          }
        ],
        "security": [
          {
            "BearerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "One summary record, then appointment records of current page; header+summary even when page empty; textual CSV formula cells escaped",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Unknown/duplicate/invalid query, GET body or ID"
          },
          "401": {
            "description": "Session absent/revoked/context changed"
          },
          "403": {
            "description": "Current permissions/device denied"
          },
          "404": {
            "description": "Order not found in current scope"
          },
          "409": {
            "description": "Contradictory receipt, rejection, stock, void or agenda evidence"
          },
          "422": {
            "description": "More than1000 source evidence records for this order; no partial totals"
          },
          "500": {
            "description": "Read failure"
          }
        }
      }
    }
  },
