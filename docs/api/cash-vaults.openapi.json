            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "VaultStatement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vault",
          "items",
          "total_count",
          "limit",
          "offset",
          "has_more"
        ],
        "properties": {
          "vault": {
            "$ref": "#/components/schemas/Vault"
