{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem local physical cash vaults",
    "version": "B02B7",
    "description": "Two workflows: received-bag cash destinations/transfers/statements; atomic cofre-to-open-drawer supply. ManageCash everywhere, POS contract for writes. Reads need no current license. Scope from session tenant/store/device. Vaults start at zero; no manual arbitrary credit. Only original bag receiver credits counted amount, once, including zero. Transfers have two equal opposite legs. Supply debits vault and calls the existing cash movement service in SAME transaction; never adopts an earlier cash operation. No expected open-drawer balance exposed. Archive only at zero; history is retained. Statements validate full account ledger and sources independently of pagination. Replies to replay/operation queries are historical snapshots, not current balances; use GET vault for current state. Local-only physical declarations, not bank accounts or statutory ledger. No query on writes or singular GET; list/statement/pending only limit/offset; duplicate/extra parameters and GET bodies rejected. No frontend integration or new legacy wire messages."
  },
  "paths": {
    "/local/v1/cash/vaults": {
      "post": {
        "operationId": "createCashVault",
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid ID/body/query or missing/duplicate/extra fields"
          },
          "401": {
            "description": "Session/device missing or revoked"
          },
          "403": {
            "description": "ManageCash/POS denied; bag credit requires its original receiver"
          },
          "404": {
            "description": "Resource outside session scope, missing or operation owned by another actor"
          },
          "409": {
            "description": "Insufficient funds, inactive destination, conflicting operation/source, source inconsistency or closed drawer"
          },
          "413": {
            "description": "Request exceeds8192 bytes"
          },
          "422": {
            "description": "Exact amount/balance range exceeded"
          },
          "500": {
            "description": "Storage failed; transaction rolls back"
          },
          "503": {
            "description": "Writes have no contract verifier"
          },
          "200": {
            "description": "Original operation snapshot for writes/receipts; current validated state for reads. All values exact integer cents. No bank or fiscal confirmation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VaultResult"
                }
              }
            }
          },
          "201": {
            "description": "Original operation snapshot for writes/receipts; current validated state for reads. All values exact integer cents. No bank or fiscal confirmation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VaultResult"
                }
