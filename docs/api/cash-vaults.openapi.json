    "schemas": {
      "Vault": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "created_by",
          "created_at",
          "updated_at",
          "creation_operation_id",
          "last_operation_id",
          "state",
          "balance_cents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_by": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "creation_operation_id": {
            "type": "string"
          },
          "last_operation_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "balance_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "VaultEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vault_id",
          "operation_id",
          "actor_id",
          "reason",
          "created_at",
          "kind",
          "delta_cents",
          "bag_id",
          "cash_session_id",
          "cash_movement_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "vault_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "deposit",
              "transfer_out",
              "transfer_in",
              "cash_supply"
            ]
          },
          "delta_cents": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "bag_id": {
            "type": "string",
            "nullable": true
          },
          "cash_session_id": {
            "type": "string",
            "nullable": true
          },
          "cash_movement_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "VaultResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "kind",
          "reason",
          "created_at",
          "repeated",
          "vaults",
          "entries",
          "bag_id",
          "cash_movement_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "deposit",
              "transfer",
              "supply",
              "archive"
            ]
          },
          "reason": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "repeated": {
            "type": "boolean"
          },
          "vaults": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/components/schemas/Vault"
            }
          },
          "entries": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "$ref": "#/components/schemas/VaultEntry"
            }
          },
          "bag_id": {
            "type": "string",
            "nullable": true
          },
          "cash_movement_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "VaultPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total_count",
          "limit",
          "offset",
          "has_more"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
