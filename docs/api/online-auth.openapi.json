{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — Autenticação online existente",
    "version": "1.1.0",
    "description": "Sessões PostgreSQL persistidas. Migração de segurança 5 obrigatória. Refresh opaco de uso único; tokens antigos exigem novo login. Autenticação SQLite é outro serviço."
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login online com credenciais e vínculo ativo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão emitida; refresh apenas no cookie HttpOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOutput"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "titan_session_rt; HttpOnly; Secure/Strict por padrão; Path=/api/v1/auth/refresh. COOKIE_SECURE=false é configuração de desenvolvimento.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Corpo não interpretável",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "E-mail, senha ou vínculo recusado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de solicitações; formato do middleware Fiber"
          },
          "503": {
            "description": "Serviço de sessão indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Renova após validar refresh e vínculo atual",
        "description": "Segredo opaco de uso único. Reutilização de hash consumido revoga a família. Resposta perdida exige novo login. Expiração absoluta de sete dias. Origem de navegador não autorizada retorna 403.",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Token de acesso e novo cookie de renovação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOutput"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "titan_session_rt; HttpOnly; Secure/Strict por padrão; Path=/api/v1/auth/refresh. COOKIE_SECURE=false é configuração de desenvolvimento.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Cookie ausente, expirado, inválido ou vínculo revogado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Consulta de vínculo indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite geral do middleware Fiber"
          },
          "403": {
            "description": "Origem de navegador recusada"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoga sessão atual e expira cookie",
        "security": [
          {
            "accessBearer": []
          }
        ],
        "description": "Sem corpo; corpo não vazio retorna 400. Empresa e usuário derivados da sessão.",
        "responses": {
          "401": {
            "description": "Sessão ausente/expirada/revogada ou alvo fora da conta"
          },
          "503": {
            "description": "Serviço indisponível"
          },
          "429": {
            "description": "Limite do middleware Fiber"
          },
          "204": {
            "description": "Revogação confirmada"
          },
          "400": {
            "description": "Corpo ou identificador inválido"
          },
          "500": {
            "description": "Chave de sessão indisponível no servidor"
          }
        }
      }
    },
    "/api/v1/auth/sessions/revoke-others": {
      "post": {
        "summary": "Revoga demais sessões da própria conta",
        "security": [
          {
            "accessBearer": []
          }
        ],
        "description": "Sem corpo; corpo não vazio retorna 400. Empresa e usuário derivados da sessão.",
        "responses": {
          "401": {
            "description": "Sessão ausente/expirada/revogada ou alvo fora da conta"
          },
          "503": {
            "description": "Serviço indisponível"
          },
          "429": {
            "description": "Limite do middleware Fiber"
          },
          "204": {
            "description": "Revogação confirmada"
          },
          "400": {
            "description": "Corpo ou identificador inválido"
          },
          "500": {
            "description": "Chave de sessão indisponível no servidor"
          }
        }
      }
    },
    "/api/v1/auth/sessions/{id}/revoke": {
      "post": {
        "summary": "Revoga uma sessão da própria conta",
        "security": [
          {
            "accessBearer": []
          }
        ],
        "description": "Sem corpo; corpo não vazio retorna 400. Empresa e usuário derivados da sessão.",
        "responses": {
          "401": {
            "description": "Sessão ausente/expirada/revogada ou alvo fora da conta"
          },
          "503": {
            "description": "Serviço indisponível"
          },
          "429": {
            "description": "Limite do middleware Fiber"
          },
          "204": {
            "description": "Revogação confirmada"
          },
          "400": {
            "description": "Corpo ou identificador inválido"
          },
          "500": {
            "description": "Chave de sessão indisponível no servidor"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "summary": "Lista até 100 sessões da própria conta",
        "security": [
          {
            "accessBearer": []
          }
        ],
        "responses": {
          "401": {
            "description": "Sessão ausente/expirada/revogada ou alvo fora da conta"
          },
          "503": {
            "description": "Serviço indisponível"
          },
          "429": {
            "description": "Limite do middleware Fiber"
          },
          "200": {
            "description": "Histórico sem tokens ou hashes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sessions",
                    "limit"
                  ],
                  "properties": {
                    "limit": {
                      "type": "integer",
                      "enum": [
                        100
                      ]
                    },
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Chave de sessão indisponível no servidor"
          }
        }
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "summary": "Troca a própria senha online e revoga todas as sessões da conta",
        "description": "Exige Bearer e sessão ativa, senha atual e nova senha diferente com 12–72 bytes UTF-8, sem espaços nas extremidades. Não aceita IDs de outra conta, campos extras, duplicatas, null ou JSON adicional. Hash, revogações e auditoria confirmam juntos. Sucesso expira cookie e exige novo login; perda de resposta não autoriza repetição automática. Limite: cinco tentativas/minuto por IP nesta rota.",
        "security": [
          {
            "accessBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "current_password",
                  "new_password"
                ],
                "properties": {
                  "current_password": {
                    "type": "string",
                    "writeOnly": true,
                    "description": "Senha atual; 1–72 bytes UTF-8"
                  },
                  "new_password": {
                    "type": "string",
                    "writeOnly": true,
                    "description": "12–72 bytes UTF-8; limite em bytes, não caracteres"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Troca e revogação confirmadas; sem token novo; realizar novo login"
          },
          "400": {
            "description": "JSON ambíguo/inválido ou política de nova senha recusada"
          },
          "401": {
            "description": "Sessão/vínculo inválido ou senha atual incorreta"
          },
          "413": {
            "description": "Corpo maior que 2048 bytes"
          },
          "415": {
            "description": "Content-Type diferente de application/json"
          },
          "429": {
            "description": "Limite de solicitações"
          },
          "500": {
            "description": "Chave de sessão ausente no servidor"
          },
          "503": {
            "description": "Serviço ou confirmação da transação indisponível; resultado pode ser incerto"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "titan_session_rt"
      },
      "accessBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT HS256 com sid"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        }
      },
      "TokenOutput": {
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role",
          "tenant_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          }
        }
      },
      "LoginOutput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TokenOutput"
          },
          {
            "type": "object",
            "required": [
              "user"
            ],
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        ]
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "created_at",
          "expires_at",
          "revoked_at",
          "current"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "current": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
