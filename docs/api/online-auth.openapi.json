{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — Autenticação online existente",
    "version": "1.0.0",
    "description": "Contrato incremental. PostgreSQL e JWT; não é contrato de autenticação SQLite. Parser legado de login ainda não rejeita todos os campos extras/duplicatas. HTTPS externo, recuperação e rotação persistida pendentes."
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login online com credenciais e vínculo ativo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão emitida; refresh apenas no cookie HttpOnly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOutput"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "titan_session_rt; HttpOnly; Secure/Strict por padrão; Path=/api/v1/auth/refresh. COOKIE_SECURE=false é configuração de desenvolvimento.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Corpo não interpretável",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "E-mail, senha ou vínculo recusado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de solicitações; formato do middleware Fiber"
          },
          "503": {
            "description": "Serviço de sessão indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Renova após validar refresh e vínculo atual",
        "description": "Não invalida individualmente o refresh anterior. Rotação persistida ainda pendente.",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Token de acesso e novo cookie de renovação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOutput"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "titan_session_rt; HttpOnly; Secure/Strict por padrão; Path=/api/v1/auth/refresh. COOKIE_SECURE=false é configuração de desenvolvimento.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Cookie ausente, expirado, inválido ou vínculo revogado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Chave de sessão indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Consulta de vínculo indisponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite geral do middleware Fiber"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "titan_session_rt"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        }
      },
      "TokenOutput": {
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "enum": [
              900
            ]
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role",
          "tenant_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          }
        }
      },
      "LoginOutput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TokenOutput"
          },
          {
            "type": "object",
            "required": [
              "user"
            ],
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        ]
      }
    }
  }
}
