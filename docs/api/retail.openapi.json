                            "production",
                            "employee",
                            "supplier"
                          ]
                        }
                      },
                      "earn_cents": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "earn_points": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "redeem_points": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
