{
  "openapi": "3.0.3",
  "info": {
    "title": "Opt-in company retail and local customer privacy",
    "version": "1.0.0"
  },
  "paths": {
    "/local/v1/retail/config": {
      "get": {
        "operationId": "readRetailConfig",
        "description": "Owner only. Defaults disabled; no commercial defaults.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current authorized data"
          },
          "204": {
            "description": "Persisted idempotent action"
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Role, store or contract denied"
          },
          "409": {
            "description": "Disabled, ineligible or revision conflict"
          }
        }
      },
      "post": {
        "operationId": "configureRetail",
        "description": "Owner only, expected revision and explicit integer policy. Idempotent operation_id.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current authorized data"
          },
          "204": {
            "description": "Persisted idempotent action"
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Role, store or contract denied"
          },
          "409": {
            "description": "Disabled, ineligible or revision conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation_id",
                  "config"
                ],
                "properties": {
                  "operation_id": {
                    "type": "string"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "revision",
                      "credit_enabled",
                      "refund_enabled",
                      "loyalty_enabled",
                      "multistore_enabled",
                      "credit_roles",
                      "refund_roles",
                      "points_roles",
                      "earn_cents",
                      "earn_points",
                      "redeem_points",
                      "redeem_cents",
                      "valid_days"
                    ],
                    "properties": {
                      "revision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "credit_enabled": {
                        "type": "boolean"
                      },
                      "refund_enabled": {
                        "type": "boolean"
                      },
                      "loyalty_enabled": {
                        "type": "boolean"
                      },
                      "multistore_enabled": {
                        "type": "boolean"
                      },
                      "credit_roles": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "manager",
                            "accountant",
                            "cashier"
                          ]
                        }
                      },
                      "refund_roles": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "manager",
                            "accountant",
                            "cashier"
                          ]
                        }
                      },
                      "points_roles": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "enum": [
                            "owner",
                            "manager",
                            "accountant",
                            "cashier"
                          ]
                        }
                      },
                      "earn_cents": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "earn_points": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "redeem_points": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "redeem_cents": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "valid_days": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/retail/customers": {
      "post": {
        "operationId": "saveRetailCustomer",
        "description": "Owner only, recorded consent and local PII; no PII copied to logs/outbox. Immutable ID; revision concurrency.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current authorized data"
          },
          "204": {
            "description": "Persisted idempotent action"
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Role, store or contract denied"
          },
          "409": {
            "description": "Disabled, ineligible or revision conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation_id",
                  "customer"
                ],
                "properties": {
                  "operation_id": {
                    "type": "string"
                  },
                  "customer": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "cpf",
                      "phone",
                      "consent_reference",
                      "revision",
                      "credit_limit_cents",
                      "block_overdue",
                      "credit_enabled",
                      "loyalty_consent"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "cpf": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      },
                      "consent_reference": {
                        "type": "string"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "credit_limit_cents": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "block_overdue": {
                        "type": "boolean"
                      },
                      "credit_enabled": {
                        "type": "boolean"
                      },
                      "loyalty_consent": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/retail/customers/{id}": {
      "get": {
        "operationId": "readRetailCustomer",
