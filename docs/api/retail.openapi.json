    "/local/v1/finance/receivables/{id}/reverse-cash": {
      "post": {
        "operationId": "reverseReceivableCash",
        "description": "Owner by default, configurable refund roles and opt-in credit policy. Explicit original receipt/device, amount, expected_reversed_cents, session and reason. Serializes compensation with receipts; cannot exceed original receipt; immutable reason and original remain. Never cancels tax note.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized data"
          },
          "204": {
            "description": "Persisted idempotent action"
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Role, store or contract denied"
          },
          "409": {
            "description": "Disabled, ineligible or revision conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "operation_id",
                  "original_operation_id",
                  "original_device_id",
                  "session_id",
                  "amount_cents",
                  "expected_reversed_cents",
                  "reason"
                ],
                "properties": {
                  "operation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "original_operation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "original_device_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "session_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "amount_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "expected_reversed_cents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/retail/sales/{id}/refund": {
      "post": {
        "operationId": "refundRetailSale",
        "description": "Opt-in financial refund for an original cash sale, by item and explicit quantity; expected quantity and cents required. Original sale, stock and tax status remain unchanged. Refuses credit/tax-bound sales and overlap with physical returns; uses cumulative integer allocation. Idempotent operation_id. Only configured refund roles under existing session/store/Finance/POS authorization.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized data"
          },
          "204": {
            "description": "Persisted idempotent action"
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Role, store or contract denied"
          },
          "409": {
            "description": "Disabled, ineligible or revision conflict"
          }
        }
      }
    }
