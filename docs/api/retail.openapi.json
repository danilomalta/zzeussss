    "/local/v1/retail/customers/{id}/privacy": {
      "post": {
        "operationId": "retailPrivacy",
        "description": "Owner performs explicit confirmed data-subject request. Export current data or anonymize contact fields, keeping financial ledger. operation_id, revision, anonymize and confirmed required.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized data"
          },
          "204": {
            "description": "Persisted idempotent action"
