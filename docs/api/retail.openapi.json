    "/local/v1/retail/operations/{id}/reconcile": {
      "post": {
        "operationId": "reconcileRetailOperation",
        "description": "Explicit same tenant/store/device/actor reconciliation. Under BEGIN IMMEDIATE, returns applied for an immutable original operation, otherwise records an immutable absent-command fence. Never resends a payload, deletes a financial effect or reveals customer personal data. Late original commands are rejected.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "confirmed"
                ],
                "properties": {
                  "confirmed": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exactly one of applied or retired, with the original operation_id"
          },
          "400": {
            "description": "Invalid confirmation"
          },
          "401": {
            "description": "Session invalid"
