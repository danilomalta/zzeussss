            "description": "Data canonica YYYY-MM-DD, ano 0001..9999; validar calendario."
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "offset"
        ]
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lot": {
            "$ref": "#/components/schemas/Lots_Lot"
          },
          "order_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "ID exato, ate 128 bytes UTF-8, sem espacos nas bordas, NUL, CR ou LF."
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "ID exato, ate 128 bytes UTF-8, sem espacos nas bordas, NUL, CR ou LF."
          },
          "quality": {
            "$ref": "#/components/schemas/Quality_Current"
          }
        },
        "required": [
          "lot",
          "order_id",
          "location_id",
          "quality"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "total_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "enum": [
              50
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        },
        "required": [
          "filters",
          "total_count",
          "limit",
          "has_more",
          "items"
        ]
      }
    }
  }
}
