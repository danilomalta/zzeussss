          },
          "409": {
            "description": "Revision/operation/source conflict. No partial cash effect."
          },
          "503": {
            "description": "Contract verifier unavailable; no change"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            }
          }
        ],
        "description": "Explicit original actor/device/store reconciliation with active Finance/manage_cash and current session. Never resends commands or reverses receipts. Returns the existing receipt, or atomically fences an absent operation forever. Concurrent delayed financial writes and reconciliation have one durable outcome. Corrupt/orphan cash evidence refuses reconciliation. Original IDs remain audited; historical GET recovers a lost reconciliation response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "document_id",
                  "action",
                  "confirmed"
                ],
                "properties": {
                  "document_id": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "create",
                      "receive_cash",
                      "cancel",
                      "reverse_cash"
                    ]
                  },
                  "confirmed": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
