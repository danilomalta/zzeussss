  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CountEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "actor_id",
          "action",
          "from_state",
          "to_state",
          "reason",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "actor_id": {
            "type": "string",
            "maxLength": 128
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "submit",
              "accept",
              "reject",
              "cancel"
            ]
          },
          "from_state": {
            "type": "string",
            "maxLength": 128
          },
          "to_state": {
            "type": "string",
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "created_at": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "VaultCount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vault_id",
          "creator_id",
          "counter_id",
          "reason",
          "state",
          "expected_cents",
          "counted_cents",
          "difference_cents",
          "vault_operation_id",
          "reviewer_id",
          "created_at",
          "updated_at",
          "last_operation_id",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "vault_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "creator_id": {
            "type": "string",
            "maxLength": 128
          },
          "counter_id": {
            "type": "string",
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "state": {
            "type": "string",
            "enum": [
              "counting",
              "submitted",
              "accepted",
              "rejected",
              "cancelled"
            ]
          },
          "expected_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "counted_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "difference_cents": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "vault_operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "reviewer_id": {
            "type": "string",
            "maxLength": 128,
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "maxLength": 64
