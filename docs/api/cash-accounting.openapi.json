{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem B02B10 — caixas encerrados para contabilidade",
    "version": "1.0.0",
    "description": "Consulta autorizada por ViewAccounting, sem trocar o ator da sessao. Operador original derivado das fontes. [from,to) por encerramento com precisao nanosegundos, max31dias. Limites10000turnos fechados no aparelho para selecao,500no periodo,10000lancamentos e CSV16MiB. Recusa datas invalidas que impedem selecionar com completude. Resumo inteiro validado antes de paginar; fonte ausente/inconsistente nao produz parcial. Complete e apenas local, nao outros aparelhos/bancos. Sem migracao; esquema51 mantido."
  },
  "paths": {
    "/local/v1/accounting/cash/sessions": {
      "get": {
        "summary": "Consulta operacional contabil de caixas encerrados: sessions",
        "description": "ViewAccounting existente; tenant/loja/aparelho da sessao. Periodo de encerramento [from,to), max31dias. Valida relatorio/journal em transacao unica, sem POS atual para historico. Somatorios de aberturas/fechamentos nao sao saldo disponivel. Comprovantes manuais e cofres nao entram.",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Recusa sem numeros ou arquivo parcial; nenhuma mutacao."
          },
          "401": {
            "description": "Recusa sem numeros ou arquivo parcial; nenhuma mutacao."
          },
          "403": {
            "description": "Recusa sem numeros ou arquivo parcial; nenhuma mutacao."
          },
          "404": {
            "description": "Recusa sem numeros ou arquivo parcial; nenhuma mutacao."
          },
          "409": {
            "description": "Recusa sem numeros ou arquivo parcial; nenhuma mutacao."
          },
          "422": {
            "description": "Recusa sem numeros ou arquivo parcial; nenhuma mutacao."
          },
          "500": {
            "description": "Recusa sem numeros ou arquivo parcial; nenhuma mutacao."
          },
          "200": {
            "description": "Historico operacional local conferido; nao e livro estatutario nem liquidacao bancaria.",
