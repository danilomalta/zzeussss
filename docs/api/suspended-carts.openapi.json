  "openapi": "3.0.3",
  "info": {
    "title": "Durable local POS carts",
    "version": "2026.10.24.1",
    "description": "Actor/device scoped. No reservations when saved/claimed. Save snapshots authoritative prices; claim and cash finalization revalidate them and free stock. All request properties required, unused fields empty/zero. Cash finalization is atomic with existing sale/journal/outbox and cart history. No electronic approvals, fiscal emission or browser integration."
