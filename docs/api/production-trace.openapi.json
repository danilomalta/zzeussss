{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem P11 consolidated production trace",
    "version": "P11",
    "description": "One authorized read transaction consolidates the frozen order and exact planned/reserved/consumed ingredients, material states, stages, actual result, global declared loss and lot totals, and one page of lots with latest human quality verdicts. No writes, reservations, consumption, stock publication, clock observation or production/quality decisions. Historical quantities are not current stock availability. Current manage_production and approved device required; authorized reads remain available after contract expiry."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/local/v1/production/orders/{id}/trace": {
      "get": {
        "operationId": "getProductionOrderTrace",
        "description": "Optional stages are null if not configured. Before completion: result, losses and lots are null; planned quantities remain explicit. Active reservation and consumed reservation are distinct; released reservations are counted but do not contribute quantities. Completed result requires real consumed-movement proof. Lot totals cover all recorded lots; voided rows remain in pages. Each quality includes current lot_status and its latest immutable assessment, or not_assessed revision 0/latest null. Do not sum quantities across different product units or interpret lot allocation as free stock. Entire report comes from the same SQLite snapshot.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "lot_offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid order ID or query: only one integer lot_offset in 0..9007199254740991 accepted"
          },
          "401": {
            "description": "Verified human session required"
          },
          "403": {
            "description": "Current human/device permission denied"
          },
          "404": {
            "description": "Order not found in tenant/store scope"
          },
          "409": {
            "description": "Inconsistent frozen recipe, reservation/consumption proof, stage definition, result, lot/loss aggregate or quality history"
          },
          "500": {
            "description": "Internal read failure"
          },
          "200": {
            "description": "Consistent scoped historical trace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trace"
                }
              }
            }
          }
        }
      }
    }
  },
