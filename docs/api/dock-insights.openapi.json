{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan local — dock planning and insights",
    "version": "2026-10-22.1"
  },
  "paths": {
    "/local/v1/logistics/insights/availability": {
      "get": {
        "operationId": "dock_insights_availability",
        "description": "manage_stock + view_orders and approved device in current tenant/store. No renewal of license for authorized historical reads. Whole-second RFC3339 bounds up to7days. Planned gaps after active appointments, first fitting end for requested duration. Disabled dock gives no gaps. confirmed_available always false: reserve again atomically through official endpoint. Actual unloading/waiting observed regardless of their planned dates; no predicted release time. Stored overlapping active windows fail explicitly.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "dock_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "duration_minutes",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 5,
              "maximum": 480
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized read snapshot; no reservation or state transition",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreeWindows"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, duplicate, unknown or empty query/body"
          },
          "401": {
            "description": "Session absent or revoked"
          },
          "403": {
            "description": "Current human/device permissions denied"
          },
          "404": {
            "description": "Dock absent in current scope"
          },
          "409": {
            "description": "Source data integrity inconsistency"
          },
          "422": {
            "description": "Over5000source appointments; narrow filters, no partial totals"
          },
          "500": {
            "description": "Internal read failure"
          }
        }
      }
    },
    "/local/v1/logistics/insights/suppliers/performance": {
      "get": {
        "operationId": "dock_insights_performance",
        "description": "manage_stock + view_orders and approved device in current tenant/store. No renewal of license for authorized historical reads. Same-store planned START cohort [from,to), up to366days; groups by supplier_id, ordered by ID, never business ranking or attribution of fault. Global metrics cover whole cohort, supplier items/CSV current page. Waiting samples end at actual unloading start; unload samples completed only. Cancelled excluded from arrival samples; all cancelled counted separately. Late arrival means >=1whole second after planned start. Exact averages preserve nanoseconds, seconds numerator/denominator strings; null/blank without samples. Source cap5000before pagination.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "dock_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized read snapshot; no reservation or state transition",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Performance"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, duplicate, unknown or empty query/body"
          },
          "401": {
            "description": "Session absent or revoked"
          },
          "403": {
            "description": "Current human/device permissions denied"
          },
          "404": {
            "description": "Dock absent in current scope"
          },
          "409": {
            "description": "Source data integrity inconsistency"
          },
          "422": {
            "description": "Over5000source appointments; narrow filters, no partial totals"
          },
          "500": {
            "description": "Internal read failure"
          }
        }
      }
    },
    "/local/v1/logistics/insights/pending": {
      "get": {
        "operationId": "dock_insights_pending",
        "description": "manage_stock + view_orders and approved device in current tenant/store. No renewal of license for authorized historical reads. Active appointments independent of planned date. Priority1cancelled order needing local resolution,2unloading,3arrived waiting,4planned end passed; stable time/ID ties. Future ordinary reservations excluded from result but included in5000source cap. No automatic no-show/cancellation/release, no persisted/sent alert. CSV returned page only; textual formulas protected.",
