  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Installment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "due_on",
          "amount_cents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "due_on": {
            "type": "string",
            "format": "date"
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "PayableEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "actor_id",
          "action",
          "from_state",
          "to_state",
          "reason",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "actor_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "approve",
              "reject",
              "cancel"
            ]
          },
          "from_state": {
            "type": "string",
            "enum": [
              "",
              "pending",
              "approved"
            ]
          },
          "to_state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "cancelled"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Payable": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "supplier_id",
          "supplier_name",
          "document_reference",
          "description",
          "issued_on",
          "currency",
          "total_cents",
          "creator_id",
          "state",
          "created_at",
          "updated_at",
          "last_operation_id",
          "installments",
          "history",
          "payment_execution_available",
          "settled_cents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "document_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "issued_on": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "type": "string",
            "enum": [
              "BRL"
            ]
          },
          "total_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "creator_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "installments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Installment"
            },
            "minItems": 1,
            "maxItems": 120
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayableEvent"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "payment_execution_available": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "settled_cents": {
            "type": "integer",
            "nullable": true,
            "enum": [
              null
            ]
          },
          "cash": {
            "$ref": "#/components/schemas/CashSummary"
          }
        }
      },
      "CreatePayable": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "payable_id",
          "supplier_id",
