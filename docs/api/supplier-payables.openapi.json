{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan contas a pagar locais",
    "version": "1.1.0",
    "description": "Obrigacoes manuais em BRL de fornecedores existentes. Nao implica recebimento, autorizacao fiscal, liquidacao, despesa contabil, banco ou baixa de caixa. Documento fica reservado apos cancelamento/rejeicao; substituicao versionada futura. Datas civis ISO sem fuso. Sem reserva de fundos. B02B12 acrescenta cash nos GET atuais; recibos documentais antigos preservados sem cash. Settled permanece null para meios externos. Agenda CSVformato2 preserva colunas anteriores e acrescenta aplicado/saldo declarado. as_of classifica vencimento,nao retrocede o livro de pagamentos: pagamentos sao estado atual na hora da leitura."
  },
  "paths": {
    "/local/v1/finance/payables": {
      "post": {
        "operationId": "supplier_payables_post_",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "description": "Leitura: ViewAccounting. Escrita: ManageCash + Finance. Aprovar nao executa pagamento. Escopo local da sessao; campos extras e duplicados recusados.",
        "responses": {
          "400": {
            "description": "Entrada invalida"
          },
          "401": {
            "description": "Sessao ausente ou revogada"
          },
          "403": {
            "description": "Permissao ou Finance indisponivel"
          },
          "404": {
            "description": "Registro nao encontrado neste contexto"
          },
          "409": {
            "description": "Documento/estado/integridade/texto CSV conflitantes"
          },
          "413": {
            "description": "Corpo excede limite"
          },
          "422": {
            "description": "Limite ou soma inexata excedido"
          },
          "500": {
            "description": "Falha interna; sem efeito parcial"
          },
          "503": {
            "description": "Verificador indisponivel"
          },
          "200": {
            "description": "Resultado ou recibo original na repeticao",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayableResult"
                }
              }
            }
          },
          "201": {
            "description": "Documento criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayableResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePayable"
              }
            }
          }
        }
      },
