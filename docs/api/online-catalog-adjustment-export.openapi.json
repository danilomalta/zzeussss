{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — Relatório CSV de reajustes percentuais",
    "version": "31.0",
    "description": "Recibos históricos; filtros por período, responsável e produto; até 10 operações/1000 linhas por página. Snapshot repetível por requisição, sem snapshot entre páginas. Não exporta outras modalidades de alteração nem preços atuais."
  },
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limit",
          "offset",
          "actor_id",
          "product_id",
          "from",
          "until",
          "total",
          "has_more",
          "row_count",
          "text_prefix",
          "source_hash",
          "csv",
          "items",
          "generated_at"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 10
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000,
            "default": 0
          },
          "actor_id": {
            "type": "string",
            "description": "UUID ou vazio quando ausente"
          },
          "product_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "0 quando sem filtro"
          },
          "from": {
            "type": "string",
            "description": "RFC3339 ou vazio"
          },
          "until": {
            "type": "string",
            "description": "RFC3339 ou vazio"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer",
            "minimum": 1
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "text_prefix": {
            "type": "string",
            "enum": [
              "'"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "csv": {
            "type": "string",
            "description": "UTF-8, separador ponto e vírgula, LF, teto 4 MiB. Não importável como cadastro."
          },
          "items": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "./online-catalog-adjustments.openapi.json#/components/schemas/AdjustmentReceipt"
            },
            "description": "Recibos inteiros originais; filtro produto limita CSV, não apaga itens do recibo."
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/catalog/adjustments/exports/preview": {
      "get": {
        "operationId": "online_adjustment_export_preview",
        "summary": "Prévia JSON do relatório",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 10
            },
            "description": "Número de operações, não de linhas CSV."
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            },
            "description": "Deslocamento em operações."
          },
          {
            "in": "query",
            "name": "actor_id",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID canônico do responsável; somente dentro da empresa autenticada."
          },
          {
            "in": "query",
            "name": "product_id",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "description": "Mantém operações que contenham o produto; CSV contém somente suas linhas."
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusivo; exige until, RFC3339 com fuso, ano 2000..9999."
          },
          {
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusivo; exige from, posterior, intervalo máximo 366 dias."
          }
        ],
        "responses": {
          "200": {
            "description": "Relatório somente leitura. Todos os dados históricos; nenhum pagamento ou documento fiscal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Filtro, período ou corpo inválido; duplicatas/desconhecidos recusados"
          },
          "401": {
            "description": "Sessão ausente ou revogada"
          },
          "403": {
            "description": "Perfil sem autorização"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Dados incompatíveis ou leitura indisponível; nenhum CSV parcial"
          }
        }
      }
    },
    "/api/v1/catalog/adjustments/exports/csv": {
      "get": {
        "operationId": "online_adjustment_export_csv",
        "summary": "Download CSV da página",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 10
            },
            "description": "Número de operações, não de linhas CSV."
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            },
            "description": "Deslocamento em operações."
          },
          {
            "in": "query",
            "name": "actor_id",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID canônico do responsável; somente dentro da empresa autenticada."
          },
          {
            "in": "query",
            "name": "product_id",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "description": "Mantém operações que contenham o produto; CSV contém somente suas linhas."
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusivo; exige until, RFC3339 com fuso, ano 2000..9999."
          },
          {
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusivo; exige from, posterior, intervalo máximo 366 dias."
          }
        ],
        "responses": {
          "200": {
            "description": "Relatório somente leitura. Todos os dados históricos; nenhum pagamento ou documento fiscal.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "X-Catalog-Source-Hash": {
                "schema": {
                  "type": "string"
                },
                "description": "SHA256 dos bytes do CSV da página"
              },
              "X-Catalog-Total": {
                "schema": {
                  "type": "integer"
                },
                "description": "Operações correspondentes"
              },
              "X-Catalog-Row-Count": {
                "schema": {
                  "type": "integer"
                },
                "description": "Linhas de produtos"
              },
              "X-Catalog-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Limite de operações"
              },
              "X-Catalog-Offset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Deslocamento de operações"
              },
              "X-Catalog-Has-More": {
                "schema": {
                  "type": "boolean"
                },
                "description": "Há outra página"
              },
              "X-Catalog-Next-Offset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Presente somente se há outra página"
              },
              "X-Catalog-Text-Prefix": {
                "schema": {
                  "type": "string"
                },
                "description": "Apóstrofo prefixado a cada célula textual"
              }
            }
          },
          "400": {
            "description": "Filtro, período ou corpo inválido; duplicatas/desconhecidos recusados"
          },
          "401": {
            "description": "Sessão ausente ou revogada"
          },
          "403": {
            "description": "Perfil sem autorização"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Dados incompatíveis ou leitura indisponível; nenhum CSV parcial"
          }
        }
      }
    }
  }
}
