{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — P63 fornecedores locais",
    "version": "P63",
    "description": "Cinco funções de interface; SQLite 44. GETs somente leitura; escritor existente exige manage_replenishment e orders ativo. IDs de escopo vêm da sessão. Recibo é original e result.repeated é sempre false."
  },
  "servers": [
    {
      "url": "/local/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/purchase-supplier-operations/{operation_id}/receipt": {
      "get": {
        "summary": "Recibo original da alteração, restrito ao operador e aparelho; não aceita query string.",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "ID exato; até 128 bytes UTF-8 no servidor."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Sessão inválida"
          },
          "403": {
            "description": "Permissão ou contrato indisponível"
          },
          "404": {
            "description": "Ausente no escopo autorizado"
          },
          "409": {
            "description": "Revisão ou dados preservados inconsistentes"
          },
          "503": {
            "description": "Serviço indisponível"
          }
        }
      }
    },
