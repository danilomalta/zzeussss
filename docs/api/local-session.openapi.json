  "components": {
    "securitySchemes": {
      "Session": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "local"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "identity_id": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "format": "password",
            "writeOnly": true
          }
        },
        "required": [
          "identity_id",
          "password"
        ],
        "additionalProperties": false
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token opaco local; não é JWT. Não registrar ou publicar."
          },
          "expires_unix": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "token",
          "expires_unix"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "store_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "identity_id": {
            "type": "string"
          },
          "expires_unix": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "tenant_id",
          "store_id",
          "device_id",
          "identity_id",
          "expires_unix"
        ],
        "additionalProperties": false
      }
    }
