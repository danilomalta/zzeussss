                }
              }
            }
          },
          "413": {
            "description": "Erro legado; JSON Error quando negociado. 429 no login após limite de tentativas.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "./http-errors.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Orçamento de autenticação excedido, resposta uniforme sem identificadores.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
