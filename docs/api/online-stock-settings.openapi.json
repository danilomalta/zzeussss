    "/api/v1/produtos/{id}/stock-settings/history": {
      "get": {
        "operationId": "onlineStockSettings43_5",
        "summary": "Consultar histórico paginado por produto",
        "description": "Empresa e usuário derivados da sessão. Parâmetros extras e corpo em GET são recusados. Histórico disponível para produto removido logicamente, com snapshots e responsáveis originais.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          }
        ],
