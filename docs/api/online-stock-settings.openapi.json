  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome",
          "descricao",
          "sku",
          "price_cents",
          "ativo",
          "version"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 999999999999
          },
          "ativo": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "Settings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimum_units",
          "reorder_point_units",
          "lead_time_days",
          "daily_demand",
          "forecast_at"
        ],
        "properties": {
          "minimum_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "reorder_point_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "lead_time_days": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 365
          },
          "daily_demand": {
            "type": "string",
            "pattern": "^[0-9]{1,8}\\.[0-9]{4}$",
            "description": "Demanda diária declarada, decimal exato em unidades. Até 99999999.9999; saída com quatro casas. Não aceita número JSON, sinal ou expoente."
          },
          "forecast_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp existente de previsão; mudança na demanda declarada o limpa. Este endpoint não gera previsão."
          }
        }
      },
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "stock_units",
          "settings"
        ],
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "stock_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        }
      },
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_version",
          "minimum_units",
          "reorder_point_units",
          "lead_time_days",
          "daily_demand",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico minúsculo e não nulo."
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "minimum_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "reorder_point_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 2147483647
          },
          "lead_time_days": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 365
          },
          "daily_demand": {
            "type": "string",
            "pattern": "^[0-9]{1,8}(\\.[0-9]{1,4})?$",
            "description": "Demanda diária declarada, decimal exato em unidades. Até 99999999.9999; saída com quatro casas. Não aceita número JSON, sinal ou expoente."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Motivo obrigatório, aparado nas pontas e validado."
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "product_id",
          "actor_id",
          "reason",
          "before",
          "after",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico minúsculo e não nulo."
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico minúsculo e não nulo."
          },
          "reason": {
            "type": "string"
          },
          "before": {
            "$ref": "#/components/schemas/Plan"
          },
          "after": {
            "$ref": "#/components/schemas/Plan"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "before",
          "after",
          "horizon_days",
          "metrics"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico minúsculo e não nulo."
          },
          "before": {
            "$ref": "#/components/schemas/Plan"
          },
          "after": {
            "$ref": "#/components/schemas/Plan"
          },
          "horizon_days": {
            "type": "integer",
            "enum": [
              7
            ]
          },
          "metrics": {
            "$ref": "online-stock-analysis.openapi.json#/components/schemas/Item"
          }
        }
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "limit",
          "offset",
          "has_more"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Receipt"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 1000000100
          }
        }
      }
    }
  }
}
