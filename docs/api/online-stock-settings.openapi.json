{
  "openapi": "3.0.3",
  "info": {
    "title": "Planejamento de estoque online — cinco funções43",
    "version": "1.0.0",
    "description": "Declarações manuais em PostgreSQL; sem reservas/movimentos SQLite, previsão automática ou pedidos. Salvar incrementa catalog_version, inclusive se os parâmetros já eram iguais. Prévia é um snapshot de leitura com horizonte7; não reserva saldo e pode ficar desatualizada antes do envio."
  },
  "paths": {
    "/api/v1/produtos/{id}/stock-settings": {
      "get": {
        "operationId": "onlineStockSettings43_1",
        "summary": "Consultar parâmetros atuais",
        "description": "Empresa e usuário derivados da sessão. Parâmetros extras e corpo em GET são recusados. ",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado confirmado.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida: extras, duplicados, campos faltantes, null, tipos ou limites incorretos."
          },
          "401": {
            "description": "Sessão inválida, expirada ou revogada."
          },
          "403": {
            "description": "Apenas owner/admin/manager."
          },
          "404": {
            "description": "Produto/recibo não encontrado no escopo permitido."
          },
          "409": {
            "description": "Versão antiga ou operação reutilizada com ator/produto/payload diferente."
          },
          "429": {
            "description": "Limite HTTP excedido; respeite Retry-After."
          },
          "503": {
            "description": "Dependência indisponível ou resultado incerto; consulte seu operation_id."
          }
        }
      },
