  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome",
          "descricao",
          "sku",
          "price_cents",
          "ativo",
          "version"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 999999999999
          },
          "ativo": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "Cost": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "known",
          "revision",
          "cost_cents",
          "actor_id",
          "updated_at"
        ],
        "properties": {
          "known": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cost_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 999999999999,
            "nullable": true
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Entry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "product_id",
          "actor_id",
          "reason",
          "before",
          "after",
          "product",
          "created_at",
          "change",
          "delta_cents"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          },
          "before": {
            "$ref": "#/components/schemas/Cost"
          },
          "after": {
            "$ref": "#/components/schemas/Cost"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "change": {
            "type": "string",
            "enum": [
              "initial",
              "increased",
              "decreased",
              "unchanged"
            ]
          },
          "delta_cents": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "minimum": -999999999999,
            "maximum": 999999999999,
            "description": "Null no primeiro custo. Nas demais alterações: custo depois menos custo antes, em centavos."
          }
        }
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "actor_id",
          "product_id",
          "change",
          "from",
          "until",
          "limit",
          "offset",
          "total",
          "items",
          "has_more",
          "generated_at",
          "source_hash"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          },
          "actor_id": {
            "type": "string",
            "description": "UUID canônico; vazio na resposta significa todos os responsáveis."
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "change": {
            "type": "string",
            "enum": [
              "all",
              "initial",
              "increased",
              "decreased",
              "unchanged"
            ],
            "default": "all"
          },
          "from": {
            "type": "string",
            "description": "RFC3339Nano ou vazio na resposta; início inclusivo."
          },
          "until": {
            "type": "string",
            "description": "RFC3339Nano ou vazio na resposta; fim exclusivo."
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000,
            "default": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1000000000
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "actor_id",
          "product_id",
          "change",
          "from",
          "until",
          "limit",
          "offset",
          "total",
          "initial",
          "increased",
          "decreased",
          "unchanged",
          "products",
          "actors",
          "generated_at"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          },
