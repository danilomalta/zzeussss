{
  "openapi": "3.0.3",
  "info": {
    "title": "Histórico auditável de custos online — entrega41",
    "version": "1.0.0",
    "description": "Consulta somente. Owner/admin/manager da empresa; sessão persistida revalidada. Filtros usam snapshots históricos, inclusive de produtos inativos/excluídos. Sem nova migração. Custos declarados não substituem escrituração contábil."
  },
  "paths": {
    "/api/v1/catalog/cost-history/summary": {
      "get": {
        "operationId": "costHistorySummary41",
        "summary": "Resumo do histórico de custos",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Busca literal, sem curingas, no nome ou SKU do snapshot. Vazio permite todos.",
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            }
          },
          {
            "name": "actor_id",
            "in": "query",
            "required": false,
            "description": "Filtro opcional. Não aceita repetição nem valor vazio.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "product_id",
            "in": "query",
            "required": false,
            "description": "Filtro opcional. Não aceita repetição nem valor vazio.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "change",
            "in": "query",
            "required": false,
            "description": "Filtro opcional. Não aceita repetição nem valor vazio.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "initial",
                "increased",
                "decreased",
                "unchanged"
              ],
              "default": "all"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Filtro opcional. Não aceita repetição nem valor vazio. Anos 2000–9999; from inclusivo, until exclusivo; from deve preceder until.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "description": "Filtro opcional. Não aceita repetição nem valor vazio. Anos 2000–9999; from inclusivo, until exclusivo; from deve preceder until.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Entrada inválida, parâmetro extra/repetido ou corpo em GET."
          },
          "401": {
            "description": "Sessão ausente, expirada ou revogada."
          },
          "403": {
            "description": "Papel sem autorização."
          },
          "429": {
            "description": "Limite de requisições."
          },
          "503": {
            "description": "Banco indisponível ou resultado inconsistente."
          },
          "200": {
            "description": "Snapshot consistente por requisição. Páginas seguintes são novas leituras e podem incluir novas alterações.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          }
        }
      }
    },
