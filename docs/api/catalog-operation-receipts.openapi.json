                      "required": [
                        "sku",
                        "name",
                        "barcode",
                        "unit",
                        "price_cents",
                        "cost_cents"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "sku": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "barcode": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "unit",
                            "kg",
                            "g",
                            "liter",
                            "ml",
                            "meter"
                          ]
                        },
                        "price_cents": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "cost_cents": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Management access denied"
          },
          "404": {
            "description": "Absent in original scope"
          },
          "409": {
            "description": "Incompatible history"
          }
        }
      }
    },
