    "/local/v1/catalog/products/{id}/edit-details": {
      "get": {
        "security": [
          {
            "localBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized immutable receipt or current transaction snapshot",
