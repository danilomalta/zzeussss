{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem — Importação CSV do catálogo online",
    "version": "28.0",
    "description": "Somente preço ou ativação de produtos existentes por SKU exato. Owner/admin/manager. Não cria produtos, não importa estoque, fiscal, fornecedores, Excel ou XML. Recibos recuperáveis e reversão via API de lotes da entrega 27. API, sem interface."
  },
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PreviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "reason",
          "csv"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "csv": {
            "type": "string",
            "minLength": 1,
            "description": "UTF-8, máximo 65536 bytes, até 100 registros. Cabeçalho exato sku;expected_version;preco;ativo. Uma alteração por SKU, de preço OU ativação. Linhas fisicamente vazias são ignoradas pelo leitor CSV; linhas de dados não são ignoradas. Vírgula ou ponto decimal, sem separador de milhares. Ativo literal true/false."
          }
        }
      },
      "ApplyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "reason",
          "csv",
          "preview_hash"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "csv": {
            "type": "string",
            "minLength": 1,
            "description": "UTF-8, máximo 65536 bytes, até 100 registros. Cabeçalho exato sku;expected_version;preco;ativo. Uma alteração por SKU, de preço OU ativação. Linhas fisicamente vazias são ignoradas pelo leitor CSV; linhas de dados não são ignoradas. Vírgula ou ponto decimal, sem separador de milhares. Ativo literal true/false."
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "reason",
          "source_hash",
          "preview_hash",
          "items"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "./online-catalog-batches.openapi.json#/components/schemas/PreviewItem"
            }
          }
        }
      },
      "ImportReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "reason",
          "source_hash",
          "preview_hash",
          "actor_id",
          "batch",
          "created_at"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "preview_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID canônico, minúsculo e não nulo."
          },
          "batch": {
            "$ref": "./online-catalog-batches.openapi.json#/components/schemas/BatchReceipt"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/catalog/imports/preview": {
      "post": {
        "operationId": "online_csv_post__api_v1_catalog_imports_preview",
        "description": "Valida CSV e resolve cada SKU exato da empresa. Prévia consistente, em ordem de ID; sem gravações de produtos, auditoria, importação ou outbox. Um erro, SKU ausente, no-op ou conflito de versão recusa toda a planilha.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo durável/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "400": {
            "description": "JSON/CSV inválido ou alteração sem efeito"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "SKU ou resultado ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash, SKU ambíguo ou operação em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou resultado incerto; consulte recibo"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              },
              "example": {
                "operation_id": "11111111-1111-4111-8111-111111111111",
                "reason": "Reajuste conferido",
                "csv": "sku;expected_version;preco;ativo\nARROZ-1;1;7,90;\nCAFE-2;3;;false\n"
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/imports/apply": {
      "post": {
        "operationId": "online_csv_post__api_v1_catalog_imports_apply",
        "description": "Aplica lote e metadados da importação na mesma transação. Hash vincula bytes do CSV, motivo, ator e snapshots. Replay devolve recibo original antes de consultar SKUs atuais. Mesmo ID com outro conteúdo/ator retorna 409.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo durável/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportReceipt"
                }
              }
            }
          },
          "400": {
            "description": "JSON/CSV inválido ou alteração sem efeito"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "SKU ou resultado ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash, SKU ambíguo ou operação em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou resultado incerto; consulte recibo"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              },
              "example": {
                "operation_id": "11111111-1111-4111-8111-111111111111",
                "reason": "Reajuste conferido",
                "csv": "sku;expected_version;preco;ativo\nARROZ-1;1;7,90;\nCAFE-2;3;;false\n",
                "preview_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/imports/{operation_id}": {
      "get": {
        "operationId": "online_csv_get__api_v1_catalog_imports_operation_id",
        "description": "Consulta do resultado estável pela empresa e ator aplicador. Outro operador ou outra empresa recebe 404. Após perda de resposta consulte antes de repetir; 503 não significa ausência.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID canônico, minúsculo e não nulo."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo durável/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportReceipt"
                }
              }
            }
          },
          "400": {
            "description": "JSON/CSV inválido ou alteração sem efeito"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "SKU ou resultado ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash, SKU ambíguo ou operação em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou resultado incerto; consulte recibo"
          }
        }
      }
    },
    "/api/v1/catalog/batches/{operation_id}/import": {
      "get": {
        "operationId": "online_csv_get__api_v1_catalog_batches_operation_id_import",
        "description": "Consulta administrativa da origem CSV de um lote da empresa. Owner/admin/manager podem consultar outro ator autorizado. Retorna hash da origem, motivo e snapshots; CSV bruto não é guardado.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "operation_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID canônico, minúsculo e não nulo."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prévia sem gravação ou recibo durável/replay, conforme a rota",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportReceipt"
                }
              }
            }
          },
          "400": {
            "description": "JSON/CSV inválido ou alteração sem efeito"
          },
          "401": {
            "description": "Sessão inválida/expirada"
          },
          "403": {
            "description": "Sem autorização"
          },
          "404": {
            "description": "SKU ou resultado ausente neste contexto"
          },
          "409": {
            "description": "Versão, hash, SKU ambíguo ou operação em conflito"
          },
          "429": {
            "description": "Limite de requisições"
          },
          "503": {
            "description": "Indisponível ou resultado incerto; consulte recibo"
          }
        }
      }
    }
  }
}
