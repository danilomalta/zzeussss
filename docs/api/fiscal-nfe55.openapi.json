    "/local/v1/fiscal/nfse": {
      "post": {
        "operationId": "customerNFSe",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "description": "Owner only. Municipal NFS-e is typed and refused until a municipality contract exists. Goods invoices and national DPS are not converted into a service invoice.",
        "responses": {
          "400": {
            "description": "Invalid municipality, service code or unconfirmed request."
          },
          "401": {
            "description": "Missing, expired or revoked human session."
          },
          "403": {
            "description": "Owner role or fiscal contract denied."
          },
          "409": {
            "description": "nfse_unavailable. No municipal adapter is invoked."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "municipality_ibge",
                  "service_code",
                  "confirmed"
                ],
                "properties": {
                  "municipality_ibge": {
                    "type": "string",
                    "pattern": "^[0-9]{7}$"
                  },
                  "service_code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  "confirmed": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/local/v1/fiscal/accounting-export": {
      "get": {
        "operationId": "fiscalAccountingExport",
        "summary": "Owner-only local archived homologation XML and CSV; UTC local-record period; missing documents explicit",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "until",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "pt-BR",
                "en",
                "es",
                "fr",
                "zh-CN"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ZIP with original XML, summary.csv and READ_ME; unavailable records listed, not SPED",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid period/query or limits: 366 days, 500 records, 50 MiB XML"
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Owner required"
          }
        }
      }
    },
    "/local/v1/fiscal/nfe55/sales/{id}/correction/query": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "post": {
        "operationId": "customerNFe55CorrectionQuery",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "description": "Owner-only, session and fiscal contract required. Homologation 55/A1 only. GET-only Focus consultation via the existing reference, and restricted XML download. Exact XML correction text must match the original server-side request SHA-256; no text, hash or private path is returned. Missing/mismatched XML or unreconciled sequence remains pending. No POST to Focus, no new sequence, no sale/payment/stock/cash change. Reconciliation status and encrypted XML use the existing database/backup and archive. A result cannot prove official acceptance without the customer real homologation trial.",
        "responses": {
          "200": {
            "description": "Separate correction status; no sale, stock or payment effect",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "correction_authorized_homologation",
                        "correction_failed",
                        "correction_reconciliation_required",
                        "correction_not_requested"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "archive_state": {
                      "type": "string",
                      "enum": [
                        "archived",
                        "pending",
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, duplicate, unknown fields, query input or unconfirmed cancellation. No personal data echoed."
          },
          "401": {
            "description": "Missing, expired or revoked human session."
          },
          "403": {
            "description": "Owner role, permissions or active fiscal module denied."
          },
          "404": {
            "description": "Sale/profile not found in authenticated scope."
          },
          "409": {
            "description": "Production blocked, A3 unsupported, incomplete input, unmapped taxes, provider unavailable or revision conflict."
          },
          "500": {
            "description": "Storage unavailable; no private inputs returned."
          },
          "503": {
            "description": "Fiscal contract unavailable."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "summary": "Explicit ID-only CC-e reconciliation; never resends"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "FiscalStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "not_requested",
              "authorized_homologation",
              "failed",
              "pending",
              "recovery_required",
              "cancelled_homologation",
              "cancellation_failed"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          },
          "error_code": {
            "type": "string",
            "maxLength": 128
          },
          "key": {
            "type": "string",
            "maxLength": 44
          },
          "intent_id": {
            "type": "string",
            "maxLength": 128
          },
          "operation_id": {
            "type": "string",
            "maxLength": 128
          },
          "can_reprocess": {
            "type": "boolean"
          }
        },
        "required": [
          "state"
        ]
      },
      "Recipient": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cpf": {
            "type": "string",
            "maxLength": 11
          },
          "cnpj": {
            "type": "string",
            "maxLength": 14
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "ie": {
            "type": "string",
            "maxLength": 14
          },
          "address": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "street": {
                "type": "string",
                "maxLength": 60
              },
              "number": {
                "type": "string",
                "maxLength": 60
              },
              "district": {
                "type": "string",
                "maxLength": 60
              },
              "city": {
                "type": "string",
                "maxLength": 60
              },
              "city_code": {
                "type": "string",
                "maxLength": 7
              },
              "uf": {
                "type": "string",
                "maxLength": 2
              },
              "postal_code": {
                "type": "string",
                "maxLength": 8
              }
            },
            "required": [
              "street",
              "number",
              "district",
              "city",
              "uf"
            ]
          }
        },
        "required": [
          "name",
          "address"
        ],
        "oneOf": [
          {
            "required": [
              "cpf"
            ],
            "properties": {
              "cpf": {
                "minLength": 1
              },
              "cnpj": {
                "maxLength": 0
              }
            }
          },
          {
            "required": [
              "cnpj"
            ],
            "properties": {
              "cnpj": {
                "minLength": 1
              },
              "cpf": {
                "maxLength": 0
              }
            }
          }
        ]
      },
      "Emission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "purpose": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4"
            ],
            "description": "1 is the mapped internal consumer sale. 2, 3 and 4 are accepted as typed requests and refused until a referenced origin snapshot exists; a common sale is not converted."
          },
          "freight_mode": {
            "type": "string",
            "enum": [
              "0",
              "1",
              "2",
              "3",
              "4",
              "9"
            ]
          },
          "recipient": {
            "$ref": "#/components/schemas/Recipient"
          },
          "transport": {
            "$ref": "#/components/schemas/Transport"
          }
        },
        "required": [
          "nature",
          "purpose",
          "freight_mode",
          "recipient"
        ]
      },
      "Cancellation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 15,
            "maxLength": 255
          },
          "confirmed": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "operation_id",
          "reason",
          "confirmed"
        ]
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sale_id": {
            "type": "string",
            "maxLength": 128
          },
          "intent_id": {
            "type": "string",
            "maxLength": 128
          },
          "total_cents": {
            "type": "integer",
            "minimum": 0
          },
          "mapping_supported": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "product_id",
                "quantity_milli",
                "unit_price_cents",
                "total_cents"
              ],
              "properties": {
                "product_id": {
                  "type": "string"
                },
                "quantity_milli": {
                  "type": "integer",
                  "minimum": 0
                },
                "unit_price_cents": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_cents": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "status": {
            "$ref": "#/components/schemas/FiscalStatus"
          },
          "accountant_approved": {
            "type": "boolean",
            "default": false
          },
          "deferred_payment_code": {
            "type": "string",
            "enum": [
              "21",
              "91"
            ],
            "description": "Frozen explicit method, absent for a recorded cash payment. Never a receipt."
          }
        },
        "required": [
          "sale_id",
          "intent_id",
          "total_cents",
          "items",
          "mapping_supported",
          "status"
        ]
      },
      "Transport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cnpj": {
            "type": "string",
            "maxLength": 14
          },
          "cpf": {
            "type": "string",
            "maxLength": 11
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "ie": {
            "type": "string",
            "maxLength": 14
          },
          "address": {
            "type": "string",
            "maxLength": 60
          },
          "city": {
            "type": "string",
            "maxLength": 60
          },
          "uf": {
            "type": "string",
            "maxLength": 2
          }
        },
        "required": [
          "name"
        ]
      }
    }
  }
}
