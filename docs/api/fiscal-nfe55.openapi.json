    "/local/v1/fiscal/nfe55/sales/{id}/invalidate": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "post": {
        "operationId": "customerNFe55Invalidate",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "description": "Owner only. Year, series and range must be explicit; the current date is never used. Focus year-ledger reconciliation is not established, so a valid request is refused with invalidation_unavailable and no number is sent.",
        "responses": {
          "400": {
            "description": "Missing year/range/reason/confirmation or inferred fields."
          },
          "401": {
            "description": "Missing, expired or revoked human session."
          },
          "403": {
            "description": "Owner role or fiscal contract denied."
          },
          "409": {
            "description": "invalidation_unavailable, production_blocked or A3 unsupported. No Focus POST."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "year",
                  "series",
                  "first",
                  "last",
                  "reason",
                  "confirmed"
                ],
                "properties": {
                  "year": {
                    "type": "integer",
                    "minimum": 2006,
                    "maximum": 2099
                  },
                  "series": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 889
                  },
                  "first": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "last": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 15,
                    "maxLength": 255
                  },
                  "confirmed": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
