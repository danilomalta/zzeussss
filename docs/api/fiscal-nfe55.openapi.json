{
  "openapi": "3.0.3",
  "info": {
    "title": "Customer NF-e 55 screen — homologation only",
    "version": "1.1.0",
    "description": " Focus: XML obtido só pelos caminhos oficiais em homologação, sem redirecionamento. xml_archive_key_file é a chave privada de backup do cliente, 32 bytes, 0600, configuração local de confiança. Arquivo cifrado AES-GCM na outbox do banco escolhido, incluído no snapshot; guardar chave fora do backup. archive_state indica archived/pending/unavailable, sem alterar autorização. Consulta da mesma referência pode repetir GET de XML, nunca reemitir. Exportação é local e nunca consulta terceiros."
  },
  "paths": {
    "/local/v1/fiscal/nfe55/sales/{id}/preview": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "post": {
        "operationId": "customerNFe55Preview",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "description": "Owner only, active session and fiscal contract. Model 55, homologation only. Normal internal consumer sale with recorded cash or explicitly selected deferred method 21/91, without freight charges. Deferred choice preserves the AR origin and creates no receipt or cash movement. Query only consults; never resends. No recipient data in logs, telemetry or browser persistence. Items and taxes come from the recorded sale. Optional confirmed payment_code freezes an idempotent server-side selection before preparing the snapshot; only for an existing credit sale with matching AR installments and no sale payments. A changed method conflicts; {} reopens an already prepared snapshot. No issuance from preview.",
        "responses": {
          "200": {
            "description": "HOMOLOGAÇÃO - SEM VALOR FISCAL. Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, duplicate, unknown fields, query input or unconfirmed cancellation. No personal data echoed."
          },
          "401": {
            "description": "Missing, expired or revoked human session."
          },
          "403": {
            "description": "Owner role, permissions or active fiscal module denied."
          },
          "404": {
            "description": "Sale/profile not found in authenticated scope."
          },
          "409": {
            "description": "Production blocked, A3 unsupported, incomplete input, unmapped taxes, provider unavailable or revision conflict."
          },
          "500": {
            "description": "Storage unavailable; no private inputs returned."
          },
          "503": {
            "description": "Fiscal contract unavailable."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "payment_code",
                      "confirmed"
                    ],
                    "properties": {
                      "payment_code": {
                        "type": "string",
                        "enum": [
                          "21",
                          "91"
                        ]
                      },
                      "confirmed": {
                        "type": "boolean",
                        "enum": [
                          true
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
