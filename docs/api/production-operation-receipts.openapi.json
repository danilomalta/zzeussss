{
  "openapi": "3.0.3",
  "info": {
    "title": "Production immutable operation receipts",
    "version": "P40",
    "description": "Read-only original receipt scoped to authenticated tenant/store/device/operator. No implicit retry. Existing production permission and approved-device checks apply; historical reads are independent of active license. Result repeated is false in the stored original receipt."
  },
  "paths": {
    "/local/v1/production/operations/{kind}/{id}": {
      "get": {
        "security": [
          {
            "localBearer": []
          }
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "recipe",
                "order",
                "state"
              ]
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original immutable operation receipt",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "input",
                        "result"
