                        "input": {
                          "type": "object",
                          "required": [
                            "operation_id",
                            "order_id",
                            "expected_revision",
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "operation_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "order_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "expected_revision": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483646
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "approved",
                                "cancelled"
                              ]
                            },
                            "reason": {
                              "type": "string"
                            }
                          }
                        },
                        "result": {
                          "type": "object",
                          "required": [
                            "order_id",
                            "revision",
                            "status",
                            "repeated"
