                            "recipe_id",
                            "version_id",
                            "expected_revision",
                            "name",
                            "output_product_id",
                            "output_unit",
                            "yield_milli",
                            "ingredients"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "operation_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "recipe_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "version_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "expected_revision": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 2147483646
                            },
                            "name": {
                              "type": "string"
                            },
                            "output_product_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "output_unit": {
                              "type": "string",
                              "enum": [
                                "unit",
                                "kg",
                                "g",
                                "liter",
                                "ml",
                                "meter"
                              ]
                            },
                            "yield_milli": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            "ingredients": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 100,
                              "items": {
                                "type": "object",
                                "required": [
                                  "product_id",
                                  "unit",
                                  "quantity_milli"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "product_id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128
                                  },
                                  "unit": {
                                    "type": "string",
                                    "enum": [
                                      "unit",
                                      "kg",
                                      "g",
                                      "liter",
                                      "ml",
                                      "meter"
                                    ]
                                  },
                                  "quantity_milli": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991
                                  }
                                }
                              }
                            }
                          }
                        },
                        "result": {
                          "type": "object",
                          "required": [
                            "recipe_id",
                            "version_id",
                            "revision",
                            "repeated"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "recipe_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "version_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "revision": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            },
                            "repeated": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "input",
                        "result"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "order"
                          ]
                        },
                        "input": {
                          "type": "object",
                          "required": [
                            "operation_id",
                            "order_id",
                            "version_id",
                            "location_id",
                            "responsible_id",
                            "planned_batches"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "operation_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "order_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "version_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "location_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "responsible_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "planned_batches": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            }
                          }
                        },
                        "result": {
                          "type": "object",
                          "required": [
                            "order_id",
                            "revision",
                            "status",
                            "repeated"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "order_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "revision": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "planned"
                              ]
                            },
                            "repeated": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "input",
                        "result"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "state"
                          ]
