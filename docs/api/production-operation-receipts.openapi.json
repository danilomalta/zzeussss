                          "additionalProperties": false,
                          "properties": {
                            "order_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "revision": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2147483647
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "approved",
                                "cancelled"
                              ]
                            },
                            "repeated": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path kind/ID or any query parameter"
          },
          "401": {
            "description": "Missing/revoked session"
          },
          "403": {
            "description": "Operator/device not authorized"
          },
          "404": {
            "description": "No operation owned by this context"
          },
          "409": {
            "description": "Inconsistent durable receipt"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
