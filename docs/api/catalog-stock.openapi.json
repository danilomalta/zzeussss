        ],
        "additionalProperties": false
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Após trim: 1–100 bytes UTF-8."
          },
          "name": {
            "type": "string",
            "description": "Após trim: 1–255 bytes UTF-8."
          },
          "barcode": {
            "type": "string",
            "description": "Opcional; vazio equivale a ausência. Não há limite explícito no cadastro atual."
          },
          "unit": {
            "type": "string",
            "enum": [
              "",
              "unit",
              "kg",
              "g",
              "liter",
              "ml",
              "meter"
            ],
            "default": "unit"
          },
          "price_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos inteiros; ausência resulta em zero no parser legado."
          },
          "cost_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos inteiros; ausência resulta em zero."
          }
        },
        "required": [
          "sku",
          "name"
        ]
      },
