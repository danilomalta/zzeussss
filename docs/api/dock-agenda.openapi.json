  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ActionInput": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "reschedule",
              "arrive",
              "start",
              "complete",
              "cancel",
              "no_show"
            ]
          },
          "dock_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "expected_revision": {
            "format": "int64",
            "maximum": 9007199254740990,
            "minimum": 1,
            "type": "integer"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "operation_id",
          "expected_revision",
          "action",
          "reason"
        ],
        "type": "object"
      },
      "Appointment": {
        "additionalProperties": false,
        "properties": {
          "appointment_id": {
            "type": "string"
          },
          "arrived_at": {
            "allOf": [
              {
                "type": "string"
              }
            ],
            "nullable": true
          },
