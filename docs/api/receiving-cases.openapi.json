    "/local/v1/purchase-receiving-cases/{id}/actions": {
      "post": {
        "operationId": "receiving_case_action",
        "description": "ViewOrders + ManageStock, active user and approved device in current tenant/store. Historical reads need no contract renewal. Signed Orders module for all writes. Exact expected_revision. start from open; note while active: assigned worker or creator when unassigned, or manager. start assigns current user if unassigned. resolve/cancel active, reopen closed, assign/set_due active: owner/manager only. Empty assigned_to unassigns; empty due_at clears. All irrelevant assigned_to/due_at MUST be empty. Reason mandatory. Each action advances revision, receipt+event+outbox in same transaction. Resolved means local administrative closure, NOT supplier acceptance/refund/stock correction. Same op retries original result, no duplicate.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
