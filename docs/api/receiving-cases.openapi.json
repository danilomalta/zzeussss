{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan local — human receiving follow-up",
    "version": "2026-10-22.1"
  },
  "paths": {
    "/local/v1/purchase-orders/{id}/receiving-cases": {
      "post": {
        "operationId": "receiving_case_open",
        "description": "ViewOrders + ManageStock, active user and approved device in current tenant/store. Historical reads need no contract renewal. Writes require signed Orders module. Create durable local follow-up; order must have valid receiving evidence, max1000source rows. Opening product/unit/quantities/flags snapshot immutable; no external agreement, payment, stock or collection effects. Worker may leave unassigned or assign self; manager may assign another currently authorized user. Kind/outcome/reference are local request/notes, never approved compensation. Same operation+normalized payload returns original snapshot, repeated true; different payload409. Whole-second due_at canonical UTC, empty string means none; may be past. Required fields even when empty; max8192body bytes.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result; all writes atomic, recorded operation recoverable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/missing/unknown/duplicate fields/query, null, GET body or invalid transition input"
          },
          "401": {
            "description": "Session absent/revoked/context changed"
          },
          "403": {
            "description": "Current permissions/device/manager/assignment/contract denied"
          },
          "404": {
            "description": "Scoped reference absent; operation also bound to original actor/device"
          },
          "409": {
            "description": "Stale revision, operation payload changed, case state or audit conflict"
          },
          "422": {
            "description": "Opening source order exceeds1000 evidence rows; no case recorded"
          },
          "500": {
            "description": "Atomic storage failure, no partial write"
          },
          "503": {
            "description": "Write verifier not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseOpenInput"
              }
            }
          }
        }
      }
    },
    "/local/v1/purchase-receiving-cases": {
      "get": {
        "operationId": "receiving_case_list",
        "description": "ViewOrders + ManageStock, active user and approved device in current tenant/store. Historical reads need no contract renewal. Stable ID order, optional filters, count whole matching set. Current/audit integrity checked for returned page; not a full audit of every off-page case. Overdue is derived for open/in_progress only, never mutates status or sends a notification.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "order_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "assigned_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "resolved",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result; all writes atomic, recorded operation recoverable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/missing/unknown/duplicate fields/query, null, GET body or invalid transition input"
          },
          "401": {
            "description": "Session absent/revoked/context changed"
          },
          "403": {
            "description": "Current permissions/device/manager/assignment/contract denied"
          },
          "404": {
            "description": "Scoped reference absent; operation also bound to original actor/device"
          },
          "409": {
            "description": "Stale revision, operation payload changed, case state or audit conflict"
          },
          "422": {
            "description": "Opening source order exceeds1000 evidence rows; no case recorded"
          },
          "500": {
            "description": "Atomic storage failure, no partial write"
          },
          "503": {
            "description": "Write verifier not configured"
          }
        }
      }
    },
