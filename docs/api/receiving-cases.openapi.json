          "case_id",
          "kind",
          "requested_outcome",
          "reference",
          "assigned_to",
          "due_at",
          "reason"
        ],
        "type": "object"
      },
      "CaseResult": {
        "additionalProperties": false,
        "properties": {
          "case": {
            "$ref": "#/components/schemas/ReceivingCase"
          },
          "operation_id": {
            "type": "string"
          },
          "repeated": {
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "case",
          "repeated"
        ],
        "type": "object"
      },
      "ReceivingCase": {
        "additionalProperties": false,
        "properties": {
