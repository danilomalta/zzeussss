  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CaseActionInput": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "note",
              "resolve",
              "cancel",
              "reopen",
              "assign",
              "set_due"
            ]
          },
          "assigned_to": {
            "type": "string"
          },
          "due_at": {
            "type": "string",
            "description": "Empty for none/clear; otherwise whole-second RFC3339, UTC-normalized, year2000..2200"
          },
          "expected_revision": {
            "format": "int64",
            "maximum": 9007199254740990,
            "minimum": 1,
            "type": "integer"
          },
          "operation_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "UTF8 max1000bytes, trimmed; newline/tab permitted, other controls rejected"
          }
        },
        "required": [
          "operation_id",
          "expected_revision",
          "action",
          "reason",
          "assigned_to",
          "due_at"
        ],
        "type": "object"
      },
      "CaseDetail": {
        "additionalProperties": false,
        "properties": {
          "case": {
            "$ref": "#/components/schemas/ReceivingCase"
          },
          "measured_at": {
            "type": "string"
          },
          "overdue": {
            "type": "boolean"
          }
        },
        "required": [
          "case",
          "overdue",
          "measured_at"
        ],
        "type": "object"
      },
      "CaseEvidence": {
        "additionalProperties": false,
        "properties": {
          "accepted_milli": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "measured_at": {
            "type": "string"
          },
          "planned_milli": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "product_id": {
            "type": "string"
          },
          "remaining_milli": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "review_flags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "unit",
          "planned_milli",
          "accepted_milli",
          "remaining_milli",
          "review_flags",
          "measured_at"
        ],
        "type": "object"
      },
      "CaseHistory": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CaseHistoryItem"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "offset": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
