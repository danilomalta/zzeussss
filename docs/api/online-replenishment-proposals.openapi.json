  "components": {
    "schemas": {
      "CreateInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "product_id",
          "expected_version",
          "review_days",
          "quantity_units",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expected_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "review_days": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 365
          },
          "quantity_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 2147483647
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Motivo obrigatório, aparado e sem caracteres de controle."
          }
        }
      },
      "DecisionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_revision",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "expected_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Motivo obrigatório, aparado e sem caracteres de controle."
          }
        }
      },
      "Proposal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product_id",
          "revision",
          "state",
          "snapshot",
          "quantity_units",
          "creator_id",
          "last_actor_id",
          "reason",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "product_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "planned",
              "approved",
              "cancelled"
            ]
          },
          "snapshot": {
            "$ref": "./online-replenishment.openapi.json#/components/schemas/Item"
          },
          "quantity_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 2147483647
          },
          "creator_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "last_actor_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Motivo obrigatório, aparado e sem caracteres de controle."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "proposal_id",
          "actor_id",
          "kind",
          "before",
          "after"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "approve",
              "cancel"
            ]
          },
          "before": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Proposal"
              }
            ],
            "description": "null na criação; snapshot da revisão anterior nas decisões."
          },
          "after": {
            "$ref": "#/components/schemas/Proposal"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
