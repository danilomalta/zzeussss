          {
            "id": "part-two",
            "due_on": "2026-10-20",
            "amount_cents": 9600
          },
          {
            "id": "part-three",
            "due_on": "2026-11-20",
            "amount_cents": 11900
          }
        ]
      },
      "status": 200,
      "expected_subset": {
        "payable": {
          "state": "pending",
          "total_cents": 31500
        },
        "origin": {
          "payable_id": "example-payable",
          "review_required": false,
          "fiscal_authorization_verified": false
        }
      }
    },
    {
