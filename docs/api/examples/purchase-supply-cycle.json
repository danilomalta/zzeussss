    {
      "name": "protected_financial_origin",
      "actor": "owner",
      "method": "GET",
      "path": "/local/v1/finance/receiving-origins/example-payable",
      "body": null,
      "status": 200,
      "expected_subset": {
        "amount_cents": 31500,
        "review_required": false,
        "fiscal_authorization_verified": false
      }
    },
    {
      "name": "physical_history_page",
      "actor": "owner",
      "method": "GET",
      "path": "/local/v1/purchase-deliveries/example-trip/history?limit=2&offset=2",
      "body": null,
      "status": 200,
      "expected_subset": {
        "total": 4,
        "limit": 2,
        "offset": 2,
        "has_more": false
      }
    },
    {
      "name": "complete_physical_totals_paged_deliveries",
      "actor": "owner",
      "method": "GET",
      "path": "/local/v1/purchase-orders/order/supply-cycle?limit=1",
      "body": null,
      "status": 200,
      "expected_subset": {
