{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan — catálogo e sugestões online",
    "version": "1.2.0",
    "description": "Entregas 18–20: paginação, cadastro estrito e geração limitada de sugestões. Sem aplicação de descontos, sincronização comercial ou fiscal."
  },
  "paths": {
    "/api/v1/produtos/": {
      "get": {
        "operationId": "onlineProductsPage",
        "summary": "Lista produtos: admin, owner, manager, cashier ou stock",
        "description": "Empresa deriva da sessão e vínculo vigente. Ordem id descendente. Página vazia retorna coleção vazia. Não há total, has_more ou snapshot entre páginas. Parâmetros desconhecidos, repetidos, vazios, sinal, fração e notação exponencial retornam 400; somente dígitos, até 10 caracteres para limit/offset. O limite passa a ser 50 por padrão; clientes que esperavam todos os registros precisam paginar.",
        "security": [
          {
            "AccessToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "./http-errors.openapi.json#/components/parameters/ErrorFormat"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página autorizada; count em sugestões é apenas o tamanho desta página.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "400": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createOnlineProduct",
        "summary": "Cadastra produto: admin, owner, manager ou stock",
        "description": "Content-Type application/json obrigatório (charset permitido). Empresa e papel derivam da sessão persistida e vínculo atual. Campos extras como tenant_id, ID, ativo ou preço fiscal são recusados. Query não seleciona empresa. Não há idempotência nesta rota: não repetir automaticamente após resposta perdida; SKU único não substitui um protocolo de operação. Esta entrega não cria auditoria de preço, outbox comercial ou integração com catálogo SQLite. A partir da entrega 25 exige Idempotency-Key. Registro/auditoria/outbox atômicos. Resposta 201 inclusive replay preserva ID e campos básicos; preco decimal exato, acrescenta price_cents, version e operation_id. Campos estatísticos anteriores não são prometidos nesta resposta.",
        "security": [
          {
            "AccessToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "./http-errors.openapi.json#/components/parameters/ErrorFormat"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID canônico não nulo salvo antes do envio; mesma identidade/conteúdo para repetir. Novo requisito da entrega 25."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOnlineProduct"
              },
              "example": {
                "nome": "Arroz 1 kg",
                "sku": "ARROZ-1",
                "descricao": "Pacote",
                "preco": 7.5,
                "estoque": 0
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "201": {
            "description": "Produto realmente persistido ou mesmo resultado original no replay; ID, nome, descricao, sku, preco numérico decimal exato, price_cents inteiro, estoque, ativo, version=1, operation_id e horários originais do produto. Consulta de produto fornece estado atual."
          },
          "409": {
            "description": "Falha de gravação, inclusive SKU já existente; sem expor SQL. Não confirma ausência de gravação em caso de perda de resposta."
          },
          "503": {
            "description": "Extensão/banco indisponível ou resultado incerto; consultar /api/v1/catalog/creations/{operation_id}"
          },
          "428": {
            "description": "Identidade ausente ou inválida; nenhum cadastro iniciado"
          }
        }
      }
    },
    "/api/v1/discounts/suggestions": {
      "get": {
        "operationId": "onlineDiscountSuggestionsPage",
        "summary": "Lista sugestões: admin, owner ou manager",
        "description": "Empresa deriva da sessão e vínculo vigente. Ordem id descendente. Página vazia retorna coleção vazia. Não há total, has_more ou snapshot entre páginas. Parâmetros desconhecidos, repetidos, vazios, sinal, fração e notação exponencial retornam 400; somente dígitos, até 10 caracteres para limit/offset. O limite passa a ser 50 por padrão; clientes que esperavam todos os registros precisam paginar.",
        "security": [
          {
            "AccessToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "./http-errors.openapi.json#/components/parameters/ErrorFormat"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "PENDING",
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED"
              ]
            },
            "description": "Filtro legado; valor vazio usa PENDING. Parâmetro repetido é recusado."
          }
        ],
        "responses": {
          "200": {
            "description": "Página autorizada; count em sugestões é apenas o tamanho desta página.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionPage"
                }
              }
            }
          },
          "400": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discounts/suggest": {
      "post": {
        "operationId": "generateOnlineDiscountSuggestions",
        "summary": "Gera sugestões heurísticas: admin, owner ou manager",
        "description": "Empresa derivada da sessão persistida e vínculo vigente. Sem payload de configuração; corpo/query não selecionam empresa nem alteram critérios. Carrega até 1001 produtos ativos em ordem de ID; se houver mais de 1000, faz rollback antes de criar. Uma transação para o conjunto. Conflito apenas no índice parcial de (tenant_id, product_id) PENDING não excluído é ignorado; outras falhas anulam o lote. Geração não altera produto/preço/saldo e não aprova descontos. Não há identificador idempotente de análise, auditoria de execução ou snapshot comercial; resposta perdida não autoriza retry automático. Reexecução pode produzir novo conjunto conforme alterações intervenientes.",
        "security": [
          {
            "AccessToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "./http-errors.openapi.json#/components/parameters/ErrorFormat"
          }
        ],
        "responses": {
          "401": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Erro legado ou Error JSON opcional.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "200": {
            "description": "Análise concluída; somente novas sugestões, sempre PENDING. Sem alteração de preço ou saldo de produto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedSuggestions"
                }
              }
            }
          },
          "409": {
            "description": "Mais de 1000 produtos ativos; nenhuma nova sugestão desta operação. Catálogo não é truncado silenciosamente."
          },
          "500": {
            "description": "Falha de consulta, gravação ou confirmação de commit; sem lista parcial ou detalhes SQL. Falha de confirmação pode deixar resultado incerto: não afirma que nada foi gravado."
          },
          "503": {
            "description": "Validação de sessão/vínculo indisponível."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "OnlineProduct": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "format": "int64"
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "DeletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "preco": {
            "type": "number",
            "format": "double",
            "description": "Representação legada float64 do catálogo online, não centavos do núcleo local. Migração monetária exata permanece pendente."
          },
          "sku": {
            "type": "string"
          },
          "estoque": {
            "type": "integer",
            "format": "int64"
          },
          "ativo": {
            "type": "boolean"
          },
          "estoque_minimo": {
            "type": "integer",
            "format": "int64"
          },
          "ponto_reposicao": {
            "type": "integer",
            "format": "int64"
          },
          "demanda_media_diaria": {
            "type": "number",
            "format": "double"
          },
          "variabilidade_demanda": {
            "type": "number",
            "format": "double"
          },
          "tempo_reposicao_dias": {
            "type": "integer",
            "format": "int64"
          },
          "ultima_previsao_demanda_em": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "alerta_reposicao_ativo": {
            "type": "boolean"
          }
        },
        "required": [
          "ID",
          "CreatedAt",
          "UpdatedAt",
          "DeletedAt",
          "nome",
          "descricao",
          "preco",
          "sku",
          "estoque",
          "ativo",
          "estoque_minimo",
          "ponto_reposicao",
          "demanda_media_diaria",
          "variabilidade_demanda",
          "tempo_reposicao_dias",
          "ultima_previsao_demanda_em",
          "alerta_reposicao_ativo"
        ],
        "additionalProperties": false
      },
      "DiscountSuggestion": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "format": "int64"
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "DeletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "product_id": {
            "type": "integer",
            "format": "int64"
          },
          "suggested_discount": {
            "type": "number",
            "format": "double"
          },
          "suggested_range": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "criteria": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reviewed_by": {
            "type": "string"
          }
        },
        "required": [
          "ID",
          "CreatedAt",
          "UpdatedAt",
          "DeletedAt",
          "product_id",
          "suggested_discount",
          "suggested_range",
          "reason",
          "criteria",
          "status",
          "reviewed_by"
        ],
        "additionalProperties": false
      },
      "ProductPage": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/OnlineProduct"
        },
        "maxItems": 100
      },
      "SuggestionPage": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 100
          },
          "sugestoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscountSuggestion"
            },
            "maxItems": 100
          }
        },
        "required": [
          "count",
          "sugestoes"
        ],
        "additionalProperties": false
      },
      "CreateOnlineProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "sku"
        ],
        "description": "Objeto JSON único até 8192 bytes. Sem chaves duplicadas, null, controles ou dados após o objeto. Nome/SKU são aparados. Preço e estoque omitidos conservam o padrão zero; descrição omitida fica vazia.",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "preco": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999999999.99,
            "multipleOf": 0.01,
            "default": 0,
            "description": "Número JSON decimal não negativo com zero, uma ou duas casas. Expoente e sinal são recusados; 1.000 também é recusado, apesar de equivaler numericamente a 1. Limite NUMERIC(12,2). Entrada validada em centavos; modelo legado ainda usa float64."
          },
          "estoque": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0,
            "description": "Somente dígitos. Fração, expoente, sinal e string são recusados. Saldo inicial legado; não representa recebimento auditado."
          }
        }
      },
      "GeneratedSuggestions": {
        "type": "object",
        "required": [
          "message",
          "items_gerados",
          "sugestoes"
        ],
        "properties": {
          "message": {
            "type": "string",
            "enum": [
              "Análise concluída."
            ]
          },
          "items_gerados": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "description": "Somente sugestões recém-criadas nesta transação; não conta conflitos de sugestão pendente."
          },
          "sugestoes": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/DiscountSuggestion"
            }
          }
        }
      }
    }
  }
}
