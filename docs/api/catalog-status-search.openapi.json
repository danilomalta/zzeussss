{
  "openapi": "3.0.3",
  "info": {
    "title": "Catalogo e filtro de estado",
    "version": "P29"
  },
  "servers": [
    {
      "url": "/local/v1"
    }
  ],
  "security": [
    {
      "localSession": []
    }
  ],
  "paths": {
    "/catalog/search": {
      "get": {
        "summary": "Busca combinada por estado; custo conforme permissao",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "unit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "unit",
                "kg",
                "g",
                "liter",
                "ml",
                "meter"
              ]
            }
          },
          {
            "name": "pending",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "barcode",
                "cost",
                "minimum"
              ]
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "default": 0
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso / replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSearchPage"
                }
              }
            }
          },
          "400": {
            "description": "Entrada invalida, query desconhecida ou JSON ambiguo"
          },
          "401": {
            "description": "Sessao invalida"
          },
          "403": {
            "description": "Sem permissao ou contrato vigente para escrita"
          },
          "404": {
            "description": "Registro nao encontrado no escopo"
          },
          "409": {
            "description": "Conflito de revisao, replay ou integridade"
          },
          "413": {
            "description": "Corpo acima de 4096 bytes"
          },
          "503": {
            "description": "Verificador indisponivel"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SearchProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sku",
          "name",
          "unit",
          "price_cents",
          "status",
          "state_revision",
          "minimum_configured",
          "approximate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "barcode": {
            "type": "string",
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "unit": {
            "type": "string",
            "enum": [
              "unit",
              "kg",
              "g",
              "liter",
              "ml",
              "meter"
            ]
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cost_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "state_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "minimum_configured": {
            "type": "boolean"
          },
          "approximate": {
            "type": "boolean"
          }
        }
      },
      "CatalogSearchPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "offset",
          "limit",
          "cost_visible",
          "status"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/SearchProduct"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "limit": {
            "type": "integer",
            "enum": [
              50
            ]
          },
          "cost_visible": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "all"
            ]
          }
        }
      }
    }
  }
}
