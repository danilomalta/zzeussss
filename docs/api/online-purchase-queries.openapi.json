  "components": {
    "schemas": {
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "state",
          "product_id",
          "limit",
          "offset",
          "items",
          "total",
          "has_more",
          "generated_at",
          "source_hash",
          "supplier_id"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "all",
              "draft",
              "approved",
              "cancelled"
            ]
          },
          "product_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000,
            "format": "int64"
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "./online-purchase-drafts.openapi.json#/components/schemas/Draft"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "supplier_id": {
            "type": "string",
            "description": "UUID do fornecedor filtrado ou string vazia sem filtro."
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "product_id",
          "total",
          "draft",
          "approved",
          "cancelled",
          "generated_at",
          "supplier_id"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "product_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "draft": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "approved": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "cancelled": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "supplier_id": {
            "type": "string",
            "description": "UUID do fornecedor filtrado ou string vazia sem filtro."
          }
        }
      },
      "History": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "limit",
          "offset",
          "has_more"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "./online-purchase-drafts.openapi.json#/components/schemas/Receipt"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "format": "int64"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000,
            "format": "int64"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "integer"
          }
        }
      },
      "Check": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purchase",
          "status",
          "checked_at",
          "current_proposal",
          "current_offer",
          "current_supplier",
          "current_product",
          "proposal_matches",
          "offer_matches",
          "supplier_matches",
          "product_matches",
          "snapshot_matches",
          "can_approve"
        ],
        "properties": {
          "purchase": {
            "$ref": "./online-purchase-drafts.openapi.json#/components/schemas/Draft"
          },
          "status": {
            "type": "string",
            "enum": [
              "matches",
              "changed",
              "parent_unavailable"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "current_proposal": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "./online-replenishment-proposals.openapi.json#/components/schemas/Proposal"
              }
            ]
          },
          "current_offer": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "./online-supplier-offers.openapi.json#/components/schemas/Offer"
              }
            ]
          },
          "current_supplier": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "./online-suppliers.openapi.json#/components/schemas/Supplier"
              }
            ]
          },
          "current_product": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "./online-stock-settings.openapi.json#/components/schemas/Plan"
              }
            ]
          },
          "proposal_matches": {
            "type": "boolean"
          },
          "offer_matches": {
            "type": "boolean"
          },
          "supplier_matches": {
            "type": "boolean"
          },
          "product_matches": {
            "type": "boolean"
          },
          "snapshot_matches": {
            "type": "boolean"
          },
          "can_approve": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
