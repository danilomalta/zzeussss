{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan — cinco consultas das compras internas",
    "version": "50.0.0",
    "description": "Resumo, lista, histórico auditado, conferência de quatro snapshots e CSV de compras internas. Não é confirmação do fornecedor, não transmite pedido, reserva estoque, gera recebimento ou pagamento. Uma chamada usa repeatable-read; páginas distintas podem mudar. can_approve é informativo e a aprovação revalida sob locks. Histórico por compra visível a gestores da mesma empresa; recibo individual49 continua restrito ao ator. CSV até100 linhas e256KiB, valores inteiros em centavos e textos protegidos por apóstrofo."
  },
  "paths": {
    "/api/v1/purchases/summary": {
      "get": {
        "operationId": "PurchaseSummary50",
        "summary": "Resumo por estado das compras internas",
        "description": "Apenas owner/admin/manager. Sem corpo. Campos extras, repetidos e parâmetros numéricos vazios recusados.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Busca literal aparada em nome/SKU do produto no snapshot e motivo atual. %, _ e barra invertida são literais."
          },
          {
            "name": "product_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "format": "int64"
            },
            "description": "Filtro por produto; não aceita0 nem zeros à esquerda. Sem parâmetro, todos os produtos."
          },
          {
            "name": "supplier_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Fornecedor do snapshot; UUID não vazio."
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta sem mutação. Cada chamada usa snapshot transacional; páginas diferentes não compartilham uma sessão de exportação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Entrada/query inválida"
          },
          "401": {
            "description": "Sessão inválida/revogada"
          },
          "403": {
            "description": "Papel não autorizado"
          },
          "404": {
            "description": "Compra inexistente ou fora da empresa autenticada"
          },
          "429": {
            "description": "Limite HTTP excedido"
          },
          "503": {
            "description": "Persistência ou dados inválidos, sem logs SQL brutos"
          }
        }
      }
    },
    "/api/v1/purchases": {
      "get": {
        "operationId": "PurchaseList50",
