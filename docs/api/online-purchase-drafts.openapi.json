{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan — compra interna com snapshots",
    "version": "49.0.0",
    "description": "Cinco funções internas. Criação requer proposta aprovada, condições e fornecedor ativos na mesma empresa, produto atual idêntico ao StockPlan aprovado, revisões esperadas e mínimo atendido. Usa quantidade da proposta, sem arredondar; total BRL=preço unitário em centavos vezes unidades, até9007199254740991. Preserva snapshots de proposta/condições/contato. Um registro por proposta mesmo cancelado. Aprovação revalida tudo sob locks; cancelamento draft/approved não depende de pais atuais. Source internal_declaration; nenhum envio, aceite externo, reserva, recebimento, título financeiro ou pagamento. Outbox durável sem despacho. Recibo individual restrito ao ator e histórico original no replay."
  },
  "paths": {
    "/api/v1/purchases": {
      "post": {
        "operationId": "PurchaseCreate49",
        "summary": "Cria compra interna de proposta aprovada",
        "description": "Owner/admin/manager; empresa e autorização da sessão revalidadas persistentemente. Sem query; GET sem corpo. JSON integral estrito até8KiB, sem campos extras/repetidos/null/trailing. Approved é aprovação interna, não aceite do fornecedor.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Estado atual ou recibo histórico imutável; replay idêntico sem nova gravação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida ou total excede inteiro seguro"
          },
          "401": {
            "description": "Sessão inválida/revogada"
          },
          "403": {
            "description": "Papel sem autorização"
          },
          "404": {
            "description": "Compra/pai inexistente na empresa ou recibo de outro ator"
          },
          "409": {
            "description": "Versão/estado/snapshot divergente, pais inativos, mínimo não atendido, proposta já vinculada ou replay divergente"
          },
          "429": {
            "description": "Limite HTTP"
          },
          "503": {
            "description": "Persistência indisponível ou registro inconsistente"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Create"
              }
            }
          }
        }
      }
    },
