  "components": {
    "schemas": {
      "Draft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "proposal_id",
          "revision",
          "state",
          "proposal",
          "offer",
          "supplier",
          "quantity_units",
          "total_cents",
          "source",
          "creator_id",
          "last_actor_id",
          "reason",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "approved",
              "cancelled"
            ]
          },
          "proposal": {
            "$ref": "./online-replenishment-proposals.openapi.json#/components/schemas/Proposal"
          },
          "offer": {
            "$ref": "./online-supplier-offers.openapi.json#/components/schemas/Offer"
          },
          "supplier": {
            "$ref": "./online-suppliers.openapi.json#/components/schemas/Supplier"
          },
          "quantity_units": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 2147483647
          },
          "total_cents": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "string",
            "enum": [
              "internal_declaration"
            ]
          },
          "creator_id": {
            "type": "string",
            "format": "uuid"
          },
          "last_actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "proposal_id",
          "offer_id",
          "expected_proposal_revision",
          "expected_offer_version",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid"
          },
          "offer_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_proposal_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expected_offer_version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_revision",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "purchase_id",
          "actor_id",
          "kind",
          "before",
          "after"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "purchase_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "create",
              "approve",
              "cancel"
            ]
          },
          "before": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Draft"
              }
            ]
          },
          "after": {
            "$ref": "#/components/schemas/Draft"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
