            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/PartInput"
            }
          },
          "freight": {
            "type": "boolean",
            "description": "Explicit selection of the frozen freight quote contract. Required true for freight-backed commands; cannot override source, amount, role or tax. Omit for legacy non-freight behavior."
          }
        },
        "required": [
          "operation_id",
          "checkout_id",
          "cash_session_id",
          "expected_total_cents",
          "items",
          "parts"
        ]
      },
      "CancelPlanInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "operation_id",
          "reason"
        ]
      },
      "Part": {
        "type": "object",
        "additionalProperties": false,
