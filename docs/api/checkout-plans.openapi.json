            "$ref": "#/components/schemas/SaleTaxBinding"
          },
          "merchandise_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "product_id",
          "location_id",
          "quantity_milli",
          "unit",
          "unit_price_cents",
          "total_cents",
          "available_milli"
        ]
      },
      "Cancellation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "cancelled_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "operation_id",
          "reason",
          "cancelled_at"
        ]
      },
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checkout_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cash_session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "type": "string",
            "enum": [
              "prepared",
              "cancelled",
              "completed"
            ]
          },
          "total_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
