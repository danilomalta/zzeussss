            "items": {
              "$ref": "#/components/schemas/Part"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "repeated": {
            "type": "boolean"
          },
          "can_finalize": {
            "type": "boolean"
          },
          "cancellation": {
            "$ref": "#/components/schemas/Cancellation"
          },
          "completion": {
            "$ref": "#/components/schemas/Completion"
          },
          "freight": {
            "type": "boolean",
            "description": "Explicit selection of the frozen freight quote contract. Required true for freight-backed commands; cannot override source, amount, role or tax. Omit for legacy non-freight behavior."
          }
        },
        "required": [
          "checkout_id",
          "operation_id",
          "cash_session_id",
          "state",
          "total_cents",
          "items",
          "parts",
          "created_at",
          "repeated",
          "can_finalize"
        ]
      },
      "Completion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sale_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sale_status": {
            "type": "string",
            "enum": [
              "committed",
              "cancelled"
            ]
          },
          "received_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "change_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "sale_id",
          "operation_id",
          "sale_status",
          "received_cents",
          "change_cents",
          "completed_at"
        ]
      },
      "FinalizeCashInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "received_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "freight": {
            "type": "boolean",
            "description": "Explicit selection of the frozen freight quote contract. Required true for freight-backed commands; cannot override source, amount, role or tax. Omit for legacy non-freight behavior."
          }
        },
        "required": [
          "operation_id",
          "received_cents"
        ]
      },
      "SaleTaxBinding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "case",
          "quote_operation_id",
          "result_sha256",
          "profile_id",
          "profile_revision",
          "additional_cents",
          "taxes",
          "totals",
          "catalog_unit"
        ],
        "properties": {
          "context": {
            "$ref": "#/components/schemas/FiscalContext"
          },
          "case": {
            "$ref": "#/components/schemas/FiscalCase"
          },
          "quote_operation_id": {
            "type": "string"
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "profile_id": {
            "type": "string"
          },
          "profile_revision": {
            "type": "integer",
            "minimum": 1
          },
          "additional_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "taxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxNode"
            }
          },
          "totals": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "properties": {}
          },
          "catalog_unit": {
            "type": "string",
            "minLength": 1
          },
          "freight": {
            "$ref": "#/components/schemas/SaleFreightContract"
          }
        },
        "description": "Immutable price evidence attached atomically to a completed sale item. Additional ST/FCP-ST/IPI is included in sale/cash/payment total; merchandise remains separately identified. It does not authorize an invoice. Optional freight is frozen from an explicit complete quote group. Additional cents include its charge; merchandise remains separate. Never attach to a completed sale."
      },
      "FiscalContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin_uf",
          "destination_uf",
          "crt",
          "model",
          "date"
        ],
        "properties": {
          "origin_uf": {
            "type": "string"
          },
          "destination_uf": {
            "type": "string"
          },
          "crt": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "FiscalCase": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "purpose",
          "origin_municipality",
          "destination_municipality",
          "recipient_status",
          "final_consumer",
          "product_origin"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "origin_municipality": {
            "type": "string"
          },
          "destination_municipality": {
            "type": "string"
          },
          "recipient_status": {
            "type": "string"
          },
          "final_consumer": {
            "type": "string"
          },
          "product_origin": {
            "type": "string"
          },
          "cest": {
            "type": "string"
          }
        }
      },
      "TaxNode": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Name": {
            "type": "string"
          },
          "Value": {
            "type": "string"
          },
          "Children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxNode"
            },
            "nullable": true
          }
        },
        "required": [
          "Name"
        ]
      },
      "SaleFreightContract": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allocation",
          "freight_mode",
          "refund_policy",
          "source_reference",
          "review_reference",
          "sale_id"
        ],
        "properties": {
          "allocation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "total_cents",
              "items"
            ],
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "largest_remainder_v1"
                ]
              },
              "total_cents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "item_id",
                    "weight"
                  ],
                  "properties": {
                    "item_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 0,
