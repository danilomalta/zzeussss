            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "quantity_milli": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "unit": {
            "type": "string",
            "enum": [
              "unit",
              "kg",
              "g",
              "l",
              "ml"
            ]
          },
          "unit_price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
