            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "checkout_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cash_session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_total_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/ItemInput"
            }
