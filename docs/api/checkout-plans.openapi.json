        "description": " P10: a sessão autenticada é revalidada no SQLite dentro da transação, mesmo sem cotação tributária. Revogação, expiração ou token de outro contexto recusam o comando; não confiar apenas na admissão HTTP. As escritas de journal/outbox do plano e o evento da venda exigem confirmação de uma linha; ausência reverte a transação. Repetir conserva os identificadores. Cancelar plano não estorna venda/pagamento nem cancela nota fiscal."
      }
    },
    "/local/v1/checkout/plans/{id}/finalize-cash": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "post": {
        "operationId": "finalizeCashCheckoutPlan",
        "security": [
          {
            "localSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinalizeCashInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cash sale committed atomically",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "200": {
            "description": "Original cash finalization recovered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid tender or ambiguous input"
          },
          "401": {
            "description": "Invalid session/device"
          },
          "403": {
            "description": "Permission or POS contract denied"
          },
          "404": {
            "description": "Checkout outside original actor scope or not found"
          },
          "409": {
            "description": "Noncash allocation, ID reuse, cancelled plan, changed prices/units, insufficient stock or closed shift"
          },
          "413": {
            "description": "Body too large"
          },
          "500": {
            "description": "Atomic write failed"
          },
          "503": {
            "description": "Verifier unavailable"
          }
        },
        "description": " P10: a sessão autenticada é revalidada no SQLite dentro da transação, mesmo sem cotação tributária. Revogação, expiração ou token de outro contexto recusam o comando; não confiar apenas na admissão HTTP. As escritas de journal/outbox do plano e o evento da venda exigem confirmação de uma linha; ausência reverte a transação. Repetir conserva os identificadores. Cancelar plano não estorna venda/pagamento nem cancela nota fiscal."
      }
    },
    "/local/v1/checkout/plans/{id}/fiscal/danfe": {
      "get": {
        "operationId": "readCheckoutFiscalDANFE",
        "summary": "Archived homologation NFC-e printing; no emission or commercial effect",
        "security": [
          {
            "localSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "width_mm",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [
                58,
                80
              ]
            }
          },
          {
            "in": "query",
            "name": "timezone",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML with archived access key, QR code and homologation watermark. Own journal or customer encrypted Focus archive.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid paper/timezone/query"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "No authorized and intact printable NFC-e; no fallback to non-fiscal receipt"
          }
        }
      }
    }
  },
  "components": {
