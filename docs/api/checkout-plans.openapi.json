{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem durable checkout allocations",
    "version": "B02B1",
    "description": "Allocation only. All parts are not_requested, provider_confirmed=false, can_finalize=false. No charge, sale, financial entry, reservation, fiscal authorization or credit grant. Original immutable quote is historical, not a price lock. No query parameters accepted. Only original actor/store/device may recover or cancel. Recover and cancel do not require an active POS license. checkout.plan.* outbox events are local audit only; transport is not implemented."
  },
  "paths": {
    "/local/v1/checkout/plans": {
      "post": {
        "operationId": "createCheckoutPlan",
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "200": {
            "description": "Original plan recovered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session or device"
          },
          "403": {
            "description": "Permission or POS contract denied"
          },
          "404": {
            "description": "Plan not found in actor scope"
          },
          "409": {
            "description": "ID reuse, stale total, stock or shift conflict"
          },
          "413": {
            "description": "Payload too large"
          },
          "500": {
            "description": "Transaction failed"
          },
          "503": {
            "description": "Verifier unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlanInput"
              }
            }
          }
        }
      }
    },
    "/local/v1/checkout/plans/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "get": {
        "operationId": "readCheckoutPlan",
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session or device"
          },
          "403": {
            "description": "Permission or POS contract denied"
          },
          "404": {
            "description": "Plan not found in actor scope"
          },
          "409": {
            "description": "ID reuse, stale total, stock or shift conflict"
          },
          "413": {
            "description": "Payload too large"
          },
          "500": {
            "description": "Transaction failed"
          },
          "503": {
            "description": "Verifier unavailable"
          }
        }
      }
    },
    "/local/v1/checkout/plans/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "post": {
        "operationId": "cancelCheckoutPlan",
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or ambiguous input"
          },
          "401": {
            "description": "Invalid session or device"
          },
          "403": {
            "description": "Permission or POS contract denied"
          },
          "404": {
            "description": "Plan not found in actor scope"
          },
          "409": {
            "description": "ID reuse, stale total, stock or shift conflict"
          },
          "413": {
            "description": "Payload too large"
          },
          "500": {
            "description": "Transaction failed"
          },
          "503": {
            "description": "Verifier unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelPlanInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PartInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "part_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "debit",
              "credit",
              "pix",
              "creditAccount"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "part_id",
          "method",
          "amount_cents"
        ]
      },
      "ItemInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "quantity_milli": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "product_id",
          "location_id",
          "quantity_milli"
        ]
      },
      "CreatePlanInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "checkout_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cash_session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_total_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/ItemInput"
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/PartInput"
            }
          }
        },
        "required": [
          "operation_id",
          "checkout_id",
          "cash_session_id",
          "expected_total_cents",
          "items",
          "parts"
        ]
      },
      "CancelPlanInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "operation_id",
          "reason"
        ]
      },
      "Part": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "part_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "debit",
              "credit",
              "pix",
              "creditAccount"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "not_requested"
            ]
          },
          "provider_confirmed": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "required": [
          "part_id",
          "method",
          "amount_cents",
          "state",
          "provider_confirmed"
        ]
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "location_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "quantity_milli": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "unit": {
            "type": "string",
            "enum": [
              "unit",
              "kg",
              "g",
              "l",
              "ml"
            ]
          },
          "unit_price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "available_milli": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "product_id",
          "location_id",
          "quantity_milli",
          "unit",
          "unit_price_cents",
          "total_cents",
          "available_milli"
        ]
      },
      "Cancellation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "cancelled_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "operation_id",
          "reason",
          "cancelled_at"
        ]
      },
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checkout_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cash_session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "type": "string",
            "enum": [
              "prepared",
              "cancelled"
            ]
          },
          "total_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "repeated": {
            "type": "boolean"
          },
          "can_finalize": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "cancellation": {
            "$ref": "#/components/schemas/Cancellation"
          }
        },
        "required": [
          "checkout_id",
          "operation_id",
          "cash_session_id",
          "state",
          "total_cents",
          "items",
          "parts",
          "created_at",
          "repeated",
          "can_finalize"
        ]
      }
    }
  }
}
