{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan pagamento e devolucao em especie de fornecedor",
    "version": "1.0.0",
    "description": "Pagamento declarado pelo ator da sangria, valor integral da fonte; pode quitar parcialmente a parcela. Devolucao integral de cada pagamento exige suprimento posterior de mesmo valor,nao financiado por cofre. Mesmo dinheiro nao financia malote e pagamento. Fontes/reservas historicas nunca reutilizadas,mesmo apos devolucao."
  },
  "paths": {
    "/local/v1/finance/payables/{id}/cash-payments": {
      "post": {
        "operationId": "payable_cash_post__local_v1_finance_payables_id_cash-payments",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "description": "Escrita:ManageCash+Finance; leitura:ViewAccounting. Escopo da sessao. Classifica caixa ja auditado; nao executa novo movimento nem comprova banco/fornecedor. Recibo de operacao apenas ao proprio ator.",
        "responses": {
          "200": {
            "description": "Consulta ou recibo original em replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrada invalida"
          },
          "401": {
            "description": "Sessao invalida"
          },
          "403": {
            "description": "Permissao/licenca ausente ou ator da fonte diferente"
          },
          "404": {
            "description": "Registro fora do escopo ou inexistente"
          },
          "409": {
            "description": "Fonte/estado/valor/conflito/integridade"
          },
          "413": {
            "description": "Corpo acima de8KiB"
          },
          "422": {
            "description": "Limites numericos/historicos"
          },
          "500": {
            "description": "Falha interna,sem escrita parcial"
          },
          "503": {
            "description": "Verificador indisponivel"
          },
          "201": {
            "description": "Vinculo registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
