{
  "openapi": "3.0.3",
  "info": {
    "title": "Historico e totais de recebimento local",
    "version": "1.0.0",
    "description": "Local human receiving workflow. Does not imply supplier transmission or external acknowledgement. Tenant/store/device derived from session."
  },
  "paths": {
    "/local/v1/purchase-orders/{id}/receiving-trace": {
      "get": {
        "summary": "Historico e totais de recebimento local",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success or exact replay",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "order_id",
                    "commercial_status",
                    "receiving_status",
                    "authorization",
                    "product_id",
                    "unit",
                    "planned_milli",
                    "delivered_milli",
                    "accepted_milli",
                    "rejected_milli",
                    "remaining_milli",
                    "total_count",
                    "offset",
                    "limit",
                    "has_more",
                    "items"
                  ],
                  "properties": {
                    "order_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "commercial_status": {
                      "type": "string",
                      "enum": [
                        "local_not_sent",
                        "cancelled"
                      ]
                    },
                    "receiving_status": {
                      "type": "string",
                      "enum": [
                        "not_authorized",
                        "authorized",
                        "partially_received",
                        "received"
                      ]
                    },
                    "authorization": {
                      "type": "object",
                      "required": [
                        "operation_id",
                        "device_id",
                        "actor_id",
                        "reference",
                        "reason",
                        "created_at"
                      ],
                      "properties": {
                        "operation_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "device_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "actor_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "reference": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "nullable": true
                    },
                    "product_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "unit",
                        "kg",
                        "g",
                        "liter",
                        "ml",
                        "meter"
                      ]
                    },
                    "planned_milli": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "limit": {
                      "type": "integer",
                      "enum": [
                        50
                      ]
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "object",
                        "required": [
                          "operation_id",
                          "delivery_reference",
                          "location_id",
                          "unit",
                          "delivered_milli",
                          "accepted_milli",
                          "reason",
                          "id",
                          "order_id",
                          "device_id",
                          "actor_id",
                          "product_id",
                          "stock_operation_id",
                          "movement_id",
                          "created_at"
                        ],
                        "properties": {
                          "operation_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "delivery_reference": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "location_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "unit": {
                            "type": "string",
                            "enum": [
                              "unit",
                              "kg",
                              "g",
                              "liter",
                              "ml",
                              "meter"
                            ]
                          },
                          "delivered_milli": {
                            "type": "integer",
                            "format": "int64",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "accepted_milli": {
                            "type": "integer",
                            "format": "int64",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "order_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "device_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "actor_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "product_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "stock_operation_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "movement_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "delivered_milli": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "accepted_milli": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rejected_milli": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "remaining_milli": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "total_count": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "offset": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Permission or contract denied"
          },
          "404": {
            "description": "Order not in authenticated scope"
          },
          "409": {
            "description": "Conflict or inconsistent evidence"
          },
          "500": {
            "description": "Unexpected database error"
          }
        },
        "description": "Requires view_orders and manage_stock. Read after contract expiry remains available. Validates every receipt before returning any page. Does not reserve or alter stock."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
