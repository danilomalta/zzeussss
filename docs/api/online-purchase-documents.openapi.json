      "get": {
        "operationId": "DocumentGet51",
        "summary": "Consulta documento e estado",
        "description": "Owner/admin/manager; empresa e autorização revalidadas na sessão persistente. Sem query; GET sem corpo. JSON estrito até8KiB. Estado prepared é documento interno, não enviado nem aceito externamente.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot interno preservado ou recibo histórico no replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, campos extras/repetidos/null/trailing ou query/body não permitido"
          },
          "401": {
            "description": "Sessão inválida/revogada"
          },
          "403": {
            "description": "Papel não autorizado"
          },
          "404": {
            "description": "Documento/compra/pai inexistente na empresa ou recibo de outro ator"
          },
          "409": {
            "description": "Revisão/estado/snapshot divergente, compra já possui documento, replay divergente ou download cancelado"
          },
          "429": {
            "description": "Limite HTTP"
          },
          "503": {
            "description": "Persistência indisponível ou registro inconsistente"
          }
        }
      }
    },
    "/api/v1/purchase-documents/{document_id}/cancel": {
      "post": {
        "operationId": "DocumentCancel51",
        "summary": "Cancela documento preservando histórico",
        "description": "Owner/admin/manager; empresa e autorização revalidadas na sessão persistente. Sem query; GET sem corpo. JSON estrito até8KiB. Estado prepared é documento interno, não enviado nem aceito externamente.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
