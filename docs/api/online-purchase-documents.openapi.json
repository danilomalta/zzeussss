{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan — documentos internos de compra",
    "version": "51.0.0",
    "description": "Cinco funções: preparar, consultar, cancelar, baixar JSON e recuperar recibo. Preparação exige compra approved, revisão esperada e proposta/condições/fornecedor/produto atuais integralmente iguais aos snapshots sob locks. Um documento por compra, mesmo cancelado. File imutável inclui compra histórica completa e identificação da preparação, hash dos bytes JSON estáveis. O documento não depende dos pais atuais para consulta/download ou cancelamento. Download preparado preserva dados históricos mesmo se a compra mudar; não atesta validade atual. Cancelamento impede download ativo, mantém file na consulta e recibos originais. Outbox durável local sem despacho. Nenhuma transmissão, confirmação externa, reserva, recebimento, pagamento ou assinatura digital."
  },
  "paths": {
    "/api/v1/purchase-documents": {
      "post": {
        "operationId": "DocumentPrepare51",
        "summary": "Prepara documento de compra aprovada",
        "description": "Owner/admin/manager; empresa e autorização revalidadas na sessão persistente. Sem query; GET sem corpo. JSON estrito até8KiB. Estado prepared é documento interno, não enviado nem aceito externamente.",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Snapshot interno preservado ou recibo histórico no replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, campos extras/repetidos/null/trailing ou query/body não permitido"
          },
          "401": {
            "description": "Sessão inválida/revogada"
          },
          "403": {
            "description": "Papel não autorizado"
          },
          "404": {
            "description": "Documento/compra/pai inexistente na empresa ou recibo de outro ator"
          },
          "409": {
            "description": "Revisão/estado/snapshot divergente, compra já possui documento, replay divergente ou download cancelado"
          },
          "429": {
            "description": "Limite HTTP"
          },
          "503": {
            "description": "Persistência indisponível ou registro inconsistente"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Prepare"
              }
            }
          }
        }
      }
    },
