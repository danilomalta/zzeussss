                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida, campos extras/repetidos/null/trailing ou query/body não permitido"
          },
          "401": {
            "description": "Sessão inválida/revogada"
          },
          "403": {
            "description": "Papel não autorizado"
          },
          "404": {
            "description": "Documento/compra/pai inexistente na empresa ou recibo de outro ator"
          },
          "409": {
            "description": "Revisão/estado/snapshot divergente, compra já possui documento, replay divergente ou download cancelado"
          },
          "429": {
            "description": "Limite HTTP"
          },
          "503": {
            "description": "Persistência indisponível ou registro inconsistente"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "File": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format_version",
          "kind",
          "document_id",
          "purchase",
          "prepared_by",
          "prepared_at"
        ],
        "properties": {
          "format_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "internal_purchase"
            ]
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "purchase": {
            "$ref": "./online-purchase-drafts.openapi.json#/components/schemas/Draft"
          },
          "prepared_by": {
            "type": "string",
            "format": "uuid"
          },
          "prepared_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Document": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purchase_id",
          "revision",
          "state",
          "file",
          "sha256",
          "creator_id",
          "last_actor_id",
          "reason",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "purchase_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "state": {
            "type": "string",
            "enum": [
              "prepared",
              "cancelled"
            ]
          },
          "file": {
            "$ref": "#/components/schemas/File"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "creator_id": {
            "type": "string",
            "format": "uuid"
          },
          "last_actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Prepare": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "purchase_id",
          "expected_purchase_revision",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "purchase_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_purchase_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Cancel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_revision",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "document_id",
          "actor_id",
          "kind",
          "before",
          "after"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "prepare",
              "cancel"
            ]
          },
          "before": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Document"
              }
            ]
          },
          "after": {
            "$ref": "#/components/schemas/Document"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
