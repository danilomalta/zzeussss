{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem B02B9 — comprovantes manuais e pendencias do checkout",
    "version": "1.0.0",
    "description": "Documento informado nao equivale a pagamento aprovado. Sell permite registrar/retirar e consultar proprio documento; ManageCash permite consultar fila/relatorio e revisar documento de outra pessoa. ProviderConfirmed permanece falso, settled_cents desconhecido null. Sem comprovacao bancaria, valor financeiro, venda mista ou adapter automatico. Plano com qualquer historico externo tem cancelamento automatico bloqueado."
  },
  "paths": {
    "/local/v1/checkout/plans/{id}/parts/{part}/proofs": {
      "post": {
        "summary": "Registra referencia manual de comprovante",
        "description": "Efeito somente documental: provider_confirmed=false. Nao aprova pagamento, nao finaliza venda, nao estorna e nao altera caixa/estoque. Leituras historicas sem contrato POS; escritas com contrato POS.",
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "400": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "401": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "403": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "404": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "409": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "413": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "422": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "500": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "503": {
            "description": "Recusa sem dados parciais nem alteracao financeira."
          },
          "200": {
            "description": "Evidencia ou recibo original; nunca confirmacao do provedor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofResult"
                }
              }
            }
          },
          "201": {
            "description": "Evidencia ou recibo original; nunca confirmacao do provedor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProofResult"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "part",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
