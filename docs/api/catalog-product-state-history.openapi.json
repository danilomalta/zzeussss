{
  "openapi": "3.0.3",
  "info": {
    "title": "Historico do estado operacional",
    "version": "P30"
  },
  "servers": [
    {
      "url": "/local/v1"
    }
  ],
  "security": [
    {
      "localSession": []
    }
  ],
  "paths": {
    "/catalog/products/{id}/state-history": {
      "get": {
        "summary": "Historico gerencial global; manage_stock, sem escrita",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso / replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductStateHistory"
                }
              }
            }
          },
          "400": {
            "description": "Entrada invalida, query desconhecida ou JSON ambiguo"
          },
          "401": {
            "description": "Sessao invalida"
          },
          "403": {
            "description": "Sem permissao ou contrato vigente para escrita"
          },
          "404": {
            "description": "Registro nao encontrado no escopo"
          },
          "409": {
            "description": "Conflito de revisao, replay ou integridade"
          },
          "413": {
            "description": "Corpo acima de 4096 bytes"
          },
          "503": {
            "description": "Verificador indisponivel"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ProductState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "status",
          "revision",
          "repeated"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "repeated": {
            "type": "boolean"
          }
        }
      },
      "ProductStateChange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "store_id",
          "operation_id",
          "device_id",
          "actor_id",
          "before_status",
          "after_status",
          "reason",
          "created_at"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "store_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "before_status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "after_status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "created_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "ProductStateHistory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current",
          "offset",
          "limit",
          "total_count",
          "has_more",
          "items"
        ],
        "properties": {
          "current": {
            "$ref": "#/components/schemas/ProductState"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "enum": [
              50
            ]
          },
          "total_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/ProductStateChange"
            }
          }
        }
      }
    }
  }
}
