{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan políticas tributárias aprovadas e memória de cálculo",
    "version": "1.1.0",
    "description": "Políticas aprovadas, versionadas, cálculo exato e grupos XML legados tipados. Sem catálogo nacional completo ou classificação automática por NCM. Fontes HTTPS governamentais ou legislativas declaradas, não verificação jurídica automática. Referência interestadual nominal 4/7/12 datada de2026; DIFAL de base única e FCP separado exigem incidência e alíquota interna explicitamente aprovadas. Sem pagamento GNRE. goods ausente permanece cálculo genérico e não autoriza vínculo automático ao emissor."
  },
  "servers": [
    {
      "url": "/local/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
