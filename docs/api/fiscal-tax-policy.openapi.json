  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin_uf",
          "destination_uf",
          "crt",
          "model",
          "date"
        ],
        "properties": {
          "origin_uf": {
            "type": "string"
          },
          "destination_uf": {
            "type": "string"
          },
          "crt": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "Case": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "purpose",
          "origin_municipality",
          "destination_municipality",
          "recipient_status",
          "final_consumer",
          "product_origin"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "origin_municipality": {
            "type": "string"
          },
          "destination_municipality": {
            "type": "string"
          },
          "recipient_status": {
            "type": "string"
          },
          "final_consumer": {
            "type": "string"
          },
          "product_origin": {
            "type": "string"
          },
          "cest": {
            "type": "string"
          }
        }
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "quantity",
          "unit_price",
          "discount",
          "freight",
          "insurance",
          "other"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "discount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "freight": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "insurance": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "other": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          }
        }
      },
      "Component": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "method",
          "rate",
          "reduction_percent",
          "mva_percent",
          "adds_to_total"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
          },
          "method": {
            "type": "string",
            "enum": [
              "percentage",
              "gross_up",
              "per_unit",
              "exempt"
            ]
          },
          "rate": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "reduction_percent": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "mva_percent": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,10})?$"
          },
          "add_applied": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "subtract_applied": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "deduct_applied": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "adds_to_total": {
            "type": "boolean"
          }
        }
      },
      "Rule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product_id",
          "cfop",
          "ncm",
          "origin_uf",
          "destination_uf",
          "crt",
          "model",
          "valid_from",
          "valid_until",
          "legal_reference",
          "approval_reference",
          "base_rounding",
          "components"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "product_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "cfop": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "origin_uf": {
            "type": "string"
          },
          "destination_uf": {
            "type": "string"
          },
          "crt": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "valid_from": {
            "type": "string"
          },
          "valid_until": {
            "type": "string"
          },
          "legal_reference": {
            "type": "string"
          },
          "approval_reference": {
            "type": "string"
          },
          "base_rounding": {
            "type": "string",
            "enum": [
              "before_tax",
              "tax_final"
            ]
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/Component"
            }
          }
        }
      },
      "PolicyInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "expected_revision",
          "profile_id",
          "profile_revision",
          "active",
          "rule",
          "case",
          "sources"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "profile_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "profile_revision": {
            "type": "integer",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          },
          "rule": {
            "$ref": "#/components/schemas/Rule"
          },
          "case": {
            "$ref": "#/components/schemas/Case"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "revision",
          "sha256",
          "actor_id",
          "created_at",
          "repeated"
        ],
        "properties": {
          "input": {
            "$ref": "#/components/schemas/PolicyInput"
          },
          "revision": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "actor_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "created_at": {
            "type": "string"
          },
          "repeated": {
            "type": "boolean"
          }
        }
      },
      "QuoteInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "policy_id",
          "policy_revision",
          "context",
          "case",
          "item"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "policy_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "policy_revision": {
            "type": "integer",
            "minimum": 1
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "case": {
            "$ref": "#/components/schemas/Case"
          },
          "item": {
            "$ref": "#/components/schemas/Item"
          }
        }
      },
      "AppliedTax": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "method",
          "base",
          "rate",
          "amount"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "rate": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "unrounded_base": {
            "type": "string"
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "cfop",
          "ncm",
          "gross",
          "net",
          "total",
          "legal_reference",
          "approval_reference",
          "taxes",
          "official_authorization"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "gross": {
            "type": "string"
          },
          "net": {
            "type": "string"
          },
          "total": {
            "type": "string"
          },
          "legal_reference": {
            "type": "string"
          },
          "approval_reference": {
            "type": "string"
          },
          "taxes": {
