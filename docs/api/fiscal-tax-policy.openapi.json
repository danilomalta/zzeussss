{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan políticas tributárias aprovadas e memória de cálculo",
    "version": "1.0.0",
    "description": "Regras explícitas por produto, operação, destinatário, UF/município, CRT, modelo e vigência. Sem catálogo legal nacional pré-carregado ou escolha automática de CST/cClassTrib/benefícios. Publicação pelo proprietário; cálculo/leitura por ViewAccounting. HTTPS gov.br é procedência declarada, não validação jurídica automática. gross_up exige base que ainda não inclui o tributo. tax_final preserva frações na transformação da base; valores monetários da operação e tributos anteriores já são arredondados."
  },
  "servers": [
    {
      "url": "/local/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
