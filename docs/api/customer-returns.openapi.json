{
  "openapi": "3.0.3",
  "info": {
    "title": "TitanSystem customer returns and cash refunds",
    "version": "2026-10-24",
    "description": "Manager/owner CancelSale permission; original local device/store and original still-open drawer. Only committed all-cash sales. Original sale/items/payments remain unchanged. restock means goods inspected as saleable and returned to original shelf; no_restock records received goods without saleable stock. No automatic waste booking, card/Pix refund, fiscal authorization or lot reconstruction. Cumulative floor(original_line_total * cumulative_return_quantity / original_quantity) allocates exact cents; expected_refund_cents must match. Quotes do not reserve quantities or authorize future writes. Persist operation_id before POST and recover by GET after an unknown response; never create another ID to resolve an uncertain result. No client tenant/actor/payment approval accepted."
  },
  "paths": {
    "/local/v1/sales/{id}/returns": {
      "get": {
        "operationId": "customer_return_get__local_v1_sales_id_returns",
        "security": [
          {
            "BearerSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid or ambiguous body/query; fractional unit or duplicate items."
          },
          "401": {
            "description": "Missing, foreign or revoked session."
          },
          "403": {
            "description": "Permission denied; writes also require POS entitlement."
          },
          "404": {
            "description": "Sale/item/operation absent from the authenticated tenant/store/device."
          },
          "409": {
            "description": "Changed quote, excess return, duplicate operation, closed/insufficient original drawer, unverified payment or inconsistent history."
          },
          "422": {
            "description": "History exceeds 1000 returns or 10000 lines; no partial result."
          },
          "500": {
            "description": "Unexpected failure; transaction rolled back."
          },
          "200": {
            "description": "Validated snapshot or original idempotent receipt. Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReturnHistory"
                }
              }
            }
          }
        }
      },
