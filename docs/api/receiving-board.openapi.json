{
  "openapi": "3.0.3",
  "info": {
    "title": "Titan local — receiving backlog board",
    "version": "2026-10-22.1"
  },
  "paths": {
    "/local/v1/management/purchases/receiving-board": {
      "get": {
        "operationId": "purchase_receiving_board",
        "description": "Single authorized read snapshot for current tenant/store: ViewOrders+ManageStock and approved device. Order-creation cohort [from,to), max366days, whole-second RFC3339 input normalized UTC. Persisted creation timestamps canonical UTC RFC3339Nano; starting fractions included, ending second excluded. Orders sorted chronologically, then ID. Optional supplier/product filter applied before source limits. All cohort evidence validated BEFORE state filter and pagination. Limits200orders,2000combined receipt+rejection+void+appointment evidence rows,1000perorder; exceeding yields422 with no partial summary. State pending excludes cancelled/fully received; received noncancelled with zero remainder; review any advisory flag, not proof of fault. Summary groups all MATCHING orders by supplier_id+product_id+unit; no mixing units. Integer milli aggregates as exact decimal strings, never float. remaining_milli_exact includes preserved remainder of cancelled orders; pending_milli_exact excludes cancelled. CohortOrders/SourceEvidence include states later excluded. Items current page only; groups independent of page. No confirmation, payment, stock mutation, purchase approval, automatic notification or contract renewal for historical read.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "product_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "all",
                "received",
                "cancelled",
                "review"
              ],
              "default": "pending"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          }
        ],
        "security": [
          {
            "BearerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot with group totals independent of item pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceivingBoard"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing/unknown/duplicate/empty/invalid query or GET body"
          },
          "401": {
            "description": "Session absent/revoked/context changed"
          },
          "403": {
            "description": "Current permissions/device denied"
          },
          "409": {
            "description": "Contradictory evidence in ANY cohort order, even excluded state/page"
          },
          "422": {
            "description": "Source cap exceeded; narrow period/supplier/product, not page/state. A single order above1000cannot be fixed by shorter board period"
          },
          "500": {
            "description": "Read failure"
          }
        }
      }
    },
    "/local/v1/management/purchases/receiving-board.csv": {
      "get": {
        "operationId": "purchase_receiving_board_csv",
        "description": "Single authorized read snapshot for current tenant/store: ViewOrders+ManageStock and approved device. Order-creation cohort [from,to), max366days, whole-second RFC3339 input normalized UTC. Persisted creation timestamps canonical UTC RFC3339Nano; starting fractions included, ending second excluded. Orders sorted chronologically, then ID. Optional supplier/product filter applied before source limits. All cohort evidence validated BEFORE state filter and pagination. Limits200orders,2000combined receipt+rejection+void+appointment evidence rows,1000perorder; exceeding yields422 with no partial summary. State pending excludes cancelled/fully received; received noncancelled with zero remainder; review any advisory flag, not proof of fault. Summary groups all MATCHING orders by supplier_id+product_id+unit; no mixing units. Integer milli aggregates as exact decimal strings, never float. remaining_milli_exact includes preserved remainder of cancelled orders; pending_milli_exact excludes cancelled. CohortOrders/SourceEvidence include states later excluded. Items current page only; groups independent of page. No confirmation, payment, stock mutation, purchase approval, automatic notification or contract renewal for historical read.",
        "parameters": [
          {
