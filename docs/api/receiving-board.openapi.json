          },
          "remaining_milli": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "review_flags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supplier_id": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "supplier_id",
          "product_id",
          "unit",
          "created_at",
          "commercial_status",
          "receiving_status",
          "planned_milli",
          "accepted_milli",
          "remaining_milli",
          "review_flags"
        ],
        "type": "object"
      },
      "ReceivingBoard": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "type": "string"
          },
          "cohort_orders": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "from": {
            "type": "string"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/BoardGroup"
            },
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BoardOrder"
            },
            "type": "array"
          },
          "limit": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "matched_orders": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "measured_at": {
            "type": "string"
          },
          "offset": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "product_id": {
            "type": "string"
          },
          "source_evidence": {
            "format": "int64",
