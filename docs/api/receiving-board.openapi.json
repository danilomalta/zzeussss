          }
        },
        "required": [
          "from",
          "to",
          "measured_at",
          "state",
          "supplier_id",
          "product_id",
          "basis",
          "cohort_orders",
          "source_evidence",
          "matched_orders",
          "limit",
          "offset",
          "groups",
          "items"
        ],
        "type": "object"
      }
    }
  }
}
