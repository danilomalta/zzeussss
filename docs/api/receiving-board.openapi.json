            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "product_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "all",
                "received",
                "cancelled",
                "review"
              ],
              "default": "pending"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          }
        ],
        "security": [
          {
            "BearerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "CSV header+summary+all matching groups+orders of current page; textual formulas escaped",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing/unknown/duplicate/empty/invalid query or GET body"
          },
          "401": {
            "description": "Session absent/revoked/context changed"
          },
          "403": {
            "description": "Current permissions/device denied"
          },
          "409": {
            "description": "Contradictory evidence in ANY cohort order, even excluded state/page"
          },
          "422": {
            "description": "Source cap exceeded; narrow period/supplier/product, not page/state. A single order above1000cannot be fixed by shorter board period"
          },
          "500": {
            "description": "Read failure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "BoardGroup": {
        "additionalProperties": false,
        "properties": {
          "accepted_milli_exact": {
            "type": "string"
          },
          "cancelled_orders": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "orders": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "pending_milli_exact": {
            "type": "string"
          },
          "pending_orders": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "planned_milli_exact": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "received_orders": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "remaining_milli_exact": {
            "type": "string"
          },
          "supplier_id": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "supplier_id",
          "product_id",
          "unit",
          "orders",
          "pending_orders",
          "received_orders",
          "cancelled_orders",
          "planned_milli_exact",
          "accepted_milli_exact",
          "remaining_milli_exact",
          "pending_milli_exact"
        ],
        "type": "object"
      },
      "BoardOrder": {
        "additionalProperties": false,
        "properties": {
          "accepted_milli": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "commercial_status": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "planned_milli": {
            "format": "int64",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "product_id": {
            "type": "string"
          },
          "receiving_status": {
