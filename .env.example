# -----------------------------------------------------------------------------
# TitanSystem - Template de Configurações de Ambiente (.env.example)
# 
# ATENÇÃO: Nunca envie valores reais de produção ou credenciais confidenciais
# para o repositório Git. Copie este arquivo para ".env" e configure localmente.
# -----------------------------------------------------------------------------

# Porta onde o servidor do backend Go será executado
PORT=8080

# Host do banco de dados PostgreSQL (use "postgres" quando rodar via docker-compose)
DB_HOST=localhost

# Porta do banco de dados PostgreSQL
DB_PORT=5432

# Nome do usuário administrativo do banco de dados
DB_USER=insira_o_usuario_db_aqui

# Senha altamente segura para acesso ao banco de dados
DB_PASSWORD=insira_a_sua_senha_segura_aqui

# Nome da base de dados principal utilizada pelo TitanSystem
DB_NAME=titansystem

# Host do servidor Redis (use "redis" quando rodar via docker-compose)
REDIS_HOST=localhost

# URL de conexão completa do Redis para operações de fila/cache
REDIS_URL=redis://localhost:6379

# Chave secreta de criptografia usada para assinar e validar os tokens JWT
JWT_SECRET=insira_uma_chave_secreta_longa_e_aleatoria_aqui
