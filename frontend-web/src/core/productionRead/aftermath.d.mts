export type AftermathKind='loss'|'loss_void'|'lot'|'lot_void'|'quality';
export interface LossInput{operation_id:string;loss_id:string;result_id:string;quantity_milli:number;reason:string}
export interface LotInput{operation_id:string;lot_id:string;result_id:string;quantity_milli:number;code:string;manufactured_on:string;expires_on:string;reason:string}
export interface VoidLoss{operation_id:string;loss_id:string;expected_revision:number;reason:string}
export interface VoidLot{operation_id:string;lot_id:string;expected_revision:number;reason:string}
export interface QualityInput{operation_id:string;lot_id:string;expected_revision:number;status:'passed'|'failed';criterion:string;reason:string}
export type AftermathBody=LossInput|LotInput|VoidLoss|VoidLot|QualityInput;
export interface ProductionAfterReference{result_id:string;product_id:string;unit:string;planned_milli:number;produced_milli:number;shortfall_milli:number}
export interface ProductionDeclaration{id:string;result_id:string;product_id:string;unit:string;quantity_milli:number;reason:string;status:'recorded'|'voided';revision:number;created_by:string;created_at:string;updated_at:string;code?:string;manufactured_on?:string;expires_on?:string}
export interface ProductionDeclarationEvent{operation_id:string;device_id:string;actor_id:string;kind:'recorded'|'voided';revision:number;reason:string;created_at:string}
export interface ProductionSummary{items:ProductionDeclaration[];recorded:number;remaining:number}
export interface ProductionQualityReview{lot_id:string;revision:number;operation_id:string;device_id:string;actor_id:string;status:'passed'|'failed';criterion:string;reason:string;lot_snapshot:ProductionDeclaration;created_at:string}
export interface ProductionQuality{lot_id:string;lot_status:'recorded'|'voided';revision:number;status:'not_assessed'|'passed'|'failed';latest:ProductionQualityReview|null}
export const aftermathPaths:Record<AftermathKind,string>;
export function aftermathInput(kind:string,value:unknown):AftermathBody|null;
export function aftermathResult(kind:AftermathKind,input:AftermathBody,result:unknown):unknown;
export function productionCalendarDate(value:string):boolean;
export function productionAftermathRow(value:unknown,kind:'loss'|'lot',reference:Pick<ProductionAfterReference,'result_id'|'product_id'|'unit'>):ProductionDeclaration;
export function productionAftermathSummary(value:unknown,kind:'loss'|'lot',reference:ProductionAfterReference):unknown;
export function productionDeclarationHistory(value:unknown):ProductionDeclarationEvent[];
export function productionQuality(value:unknown,lot:ProductionDeclaration):ProductionQuality;
export function productionQualityHistory(value:unknown,lot:ProductionDeclaration,offset:number):ProductionQualityReview[];
