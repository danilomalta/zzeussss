export type ReviewedStatus='open'|'submitted'|'approved'|'rejected'|'cancelled';
export type ReviewedKind='open'|'count'|'state';
export type ReviewedAction='submit'|'reopen'|'approve'|'reject'|'cancel';
export interface ReviewedOpen{operation_id:string;inventory_id:string;location_id:string;title:string;items:{product_id:string;unit:string}[]}
export interface ReviewedCount{operation_id:string;expected_revision:number;items:{product_id:string;counted_milli:number}[]}
export interface ReviewedState{operation_id:string;expected_revision:number;action:ReviewedAction;reason:string}
export type ReviewedBody=ReviewedOpen|ReviewedCount|ReviewedState;
export interface ReviewedCommand{version:1;scope:string;kind:ReviewedKind;inventory_id:string;body:ReviewedBody;uncertain:boolean}
export interface ReviewedResult{operation_id:string;inventory_id:string;action:string;revision:number;status:ReviewedStatus;changed_lines:number;occurred_at:string;repeated:boolean}
export interface ReviewedSession{inventory_id:string;location_id:string;title:string;status:ReviewedStatus;revision:number;created_by:string;created_at:string;updated_at:string}
export interface ReviewedLine{product_id:string;unit:string;counted_milli:number|null;previous_milli:number|null;difference_milli:number|null;counted_by:string|null;counted_at:string|null;movement_id:string|null}
export interface ReviewedDetail{inventory:ReviewedSession;lines:ReviewedLine[]}
export interface ReviewedEvent{revision:number;operation_id:string;actor_id:string;device_id:string;action:string;reason:string;occurred_at:string;request:ReviewedBody;result:ReviewedResult}
export interface ReviewedPage<T>{items:T[];total:number;limit:number;offset:number}
export const reviewedStatuses:ReviewedStatus[];
export function reviewedID(value:unknown):boolean;
export function reviewedQuantity(value:string,unit:string):number;
export function reviewedQuantityText(value:number,locale:string):string;
export function reviewedInput(kind:ReviewedKind,inventoryID:string,value:unknown):ReviewedBody;
export function reviewedCommand(value:unknown,scope:string):ReviewedCommand;
export function reviewedResult(value:unknown,command:Pick<ReviewedCommand,'kind'|'inventory_id'|'body'>,original?:boolean):ReviewedResult;
export function reviewedSession(value:unknown):ReviewedSession;
export function reviewedDetail(value:unknown,inventoryID:string):ReviewedDetail;
export function reviewedCanAction(detail:ReviewedDetail,actor:string,reviewer:boolean,action:ReviewedAction|'count'):boolean;
export function reviewedPage<T>(value:unknown,offset:number,limit?:number):ReviewedPage<T>;
export function reviewedList(value:unknown,offset:number,status?:string):ReviewedPage<ReviewedSession>;
export function reviewedHistory(value:unknown,inventoryID:string,offset:number,limit?:number):ReviewedPage<ReviewedEvent>;
export function reviewedOriginal(receipt:unknown,event:unknown,command:ReviewedCommand,actor:string,device:string):ReviewedResult;
