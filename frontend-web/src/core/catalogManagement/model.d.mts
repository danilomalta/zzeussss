export interface Product{sku:string;name:string;unit:string;barcode:string;price_cents:number;cost_cents:number}
export interface Details{product_id:string;revision:number;product:Product}
export interface ProductState{product_id:string;revision:number;status:'active'|'inactive';repeated:boolean}
export type EditInput=Product&{operation_id:string;expected_revision:number};
export interface StateInput{operation_id:string;expected_revision:number;status:'active'|'inactive';reason:string}
export type CatalogCommand={version:1;scope:string;product_id:string;uncertain:boolean}&({kind:'edit';before:Details;body:EditInput}|{kind:'state';before:ProductState;body:StateInput});
export interface EditResult{product_id:string;revision:number;repeated:boolean}
export interface CatalogReceipt{kind:'edit'|'state';input:(EditInput|StateInput)&{product_id:string};result:EditResult|ProductState}
export interface StateEvent{revision:number;store_id:string;operation_id:string;device_id:string;actor_id:string;before_status:'active'|'inactive';after_status:'active'|'inactive';reason:string;created_at:string}
export interface StateHistory{current:ProductState;offset:number;limit:50;total_count:number;has_more:boolean;items:StateEvent[]}
export const catalogUnits:string[];
export function catalogID(value:unknown):boolean;
export function catalogEqual(a:unknown,b:unknown):boolean;
export function catalogProduct(value:unknown):Product;
export function catalogDetails(value:unknown,id:string):Details;
export function catalogState(value:unknown,id:string):ProductState;
export function catalogCents(text:string):number;
export function catalogMoneyInput(value:number):string;
export function catalogInput(kind:'edit'|'state',before:Details|ProductState,body:EditInput|StateInput,id:string):EditInput|StateInput;
export function catalogCommand(value:unknown,scope:string):CatalogCommand;
export function catalogResult(value:unknown,command:CatalogCommand,original?:boolean):EditResult|ProductState;
export function catalogReceipt(value:unknown,command:CatalogCommand):CatalogReceipt;
export function catalogHistory(value:unknown,id:string,offset?:number):StateHistory;
