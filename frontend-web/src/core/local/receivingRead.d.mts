export interface PurchaseSummary {id:string;supplier_id:string;supplier_name:string;status:string;receiving_status:string;created_at:string;items:{product_id:string;sku:string;name:string;unit:string;quantity_milli:number}[]}
export interface PurchaseSearch {total_count:number;offset:number;has_more:boolean;items:PurchaseSummary[]}
export interface ReceiptVoid {receipt_id:string;order_id:string;quantity_milli:number;unit:string;actor_id:string;reason:string;location_id:string;created_at:string}
export interface Receipt {id:string;order_id:string;delivery_reference:string;unit:string;delivered_milli:number;accepted_milli:number;reason:string;location_id:string;actor_id:string;created_at:string;void?:ReceiptVoid}
export interface Rejection {id:string;order_id:string;delivery_reference:string;unit:string;delivered_milli:number;reason:string;actor_id:string;created_at:string}
export type HistoryEntry={kind:'received';id:string;created_at:string;receipt:Receipt}|{kind:'rejected';id:string;created_at:string;rejection:Rejection}|{kind:'voided';id:string;created_at:string;void:ReceiptVoid};
export interface ReceivingHistory {order_id:string;commercial_status:string;receiving_status:string;product_id:string;unit:string;total_count:number;offset:number;has_more:boolean;totals:{planned_milli:number;effective_accepted_milli:number;effective_delivered_milli:number;partial_rejected_milli:number;remaining_milli:number;fully_rejected_milli_exact:string;voided_accepted_milli_exact:string;recorded_accepted_milli_exact:string};items:HistoryEntry[]}
export function createReceivingRead(fetcher?:typeof fetch):{orders(token:string,supplier?:string,product?:string,offset?:number):Promise<PurchaseSearch>;history(token:string,orderID:string,offset?:number):Promise<ReceivingHistory>};
